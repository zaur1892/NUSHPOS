<UserControl x:Class="NUSHPOS.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NUSHPOS.Views"
             xmlns:helpers="clr-namespace:NUSHPOS.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1024"
             Background="#00A2E8">
    <UserControl.Resources>
        <Style x:Key="TopTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Padding" Value="5,15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="2,5"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#80FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <local_conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" xmlns:local_conv="clr-namespace:NUSHPOS.Converters"/>
        <local_conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" xmlns:local_conv="clr-namespace:NUSHPOS.Converters"/>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Header / Tabs -->
            <Border Grid.Row="0" Background="#4A6572" BorderThickness="0,0,0,1" BorderBrush="#344955">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Grid.Column="0">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ToggleButton x:Name="CatButton" Background="Transparent" Foreground="White" BorderThickness="0"
                                                  FontSize="14" FontWeight="SemiBold" Padding="15,15"
                                                  Content="{Binding CategoryName}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="border" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#66FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    
                                    <Popup IsOpen="{Binding IsChecked, ElementName=CatButton}" PlacementTarget="{Binding ElementName=CatButton}" Placement="Bottom" StaysOpen="False">
                                        <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" MinWidth="250" MaxHeight="500">
                                            <ItemsControl ItemsSource="{Binding Reports}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Background="White" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="10,8" HorizontalContentAlignment="Left"
                                                                Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <StackPanel Orientation="Horizontal">
                                                                <!-- Simple colored boxes mimicking the icon in screenshot -->
                                                                <Grid Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                    <Rectangle Fill="#F4B400" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                                    <Rectangle Fill="#4285F4" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                                                    <Rectangle Fill="#DB4437" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                                                    <Rectangle Fill="#0F9D58" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding ReportName}" Foreground="#333333" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="5,0,10,0">
                    <Button Style="{StaticResource ActionButtonStyle}" Background="#4285F4" Content="YENİ" Command="{Binding NewReportCommand}"/>
                    <Button Style="{StaticResource ActionButtonStyle}" Background="#212121" Content="DÜZENLE" Command="{Binding EditReportCommand}"/>
                    <Button Style="{StaticResource ActionButtonStyle}" Background="#D32F2F" Content="X" FontWeight="Bold" Command="{Binding GoBackCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Background="#00A2E8">
            <TabControl Background="Transparent" BorderThickness="0" ItemsSource="{Binding OpenReports}" SelectedItem="{Binding SelectedReport}">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Background="#E6EAF0" BorderThickness="1" BorderBrush="#B9C7D4" Margin="2,0" Padding="5,2" CornerRadius="2,2,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Report.ReportName}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <Button Content="x" Command="{Binding DataContext.CloseReportCommand, RelativeSource={RelativeSource AncestorType=TabControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="Red" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid Background="#7992A6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Toolbar -->
                            <Border Grid.Row="0" Background="#E6EAF0" Padding="5" BorderBrush="#B9C7D4" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="⬇" Margin="2,0"/>
                                    <DatePicker SelectedDate="{Binding StartDate}" Margin="2,0"/>
                                    <Button Content="⬆" Margin="2,0"/>
                                    <Button Content="⬇" Margin="10,0,2,0"/>
                                    <DatePicker SelectedDate="{Binding EndDate}" Margin="2,0"/>
                                    <Button Content="▶" Margin="2,0"/>
                                    <Button Content="UYGULA" Command="{Binding ApplyCommand}" Margin="10,0,2,0" Padding="15,5" Background="#E6EAF0" BorderBrush="#B9C7D4"/>
                                    <Button Content="EXCEL" Command="{Binding ExportToExcelCommand}" Margin="10,0,2,0" Padding="15,5" Background="#4CAF50" Foreground="White" BorderBrush="#388E3C" Visibility="{Binding IsHtmlReport, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    <Button Content="🖨" Command="{Binding PrintPosReportCommand}" ToolTip="Hesabatı POS Printerindən Çıxar" Margin="10,0,2,0" Padding="8,5" Background="#E6EAF0" BorderBrush="#B9C7D4"/>
                                    <Button Content="🖨" Command="{Binding PrintA4ReportCommand}" ToolTip="Hesabatı A4 Printerindən Çıxar" Margin="2,0" Padding="8,5" Background="#E6EAF0" BorderBrush="#B9C7D4"/>
                                    <Button Content="❓" Command="{Binding PrintPromptPrinterCommand}" ToolTip="Hansı printerdən çıxarım? (Printer Seç)" Margin="2,0" Padding="8,5" Background="#E6EAF0" BorderBrush="#B9C7D4"/>
                                    <Button Content="📐" Command="{Binding DataContext.EditReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="Dizayn Redaktoru" Margin="2,0" Padding="8,5" Background="#E6EAF0" BorderBrush="#B9C7D4"/>
                                </StackPanel>
                            </Border>

                            <!-- Report Document Viewer / Generic DataGrid -->
                            <ContentControl Grid.Row="1" Margin="0,10,0,0" Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <TabControl ItemsSource="{Binding QueryResults}" Background="White">
                                                        <TabControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding QueryName}" FontWeight="SemiBold"/>
                                                            </DataTemplate>
                                                        </TabControl.ItemTemplate>
                                                        <TabControl.ContentTemplate>
                                                            <DataTemplate>
                                                                <DataGrid ItemsSource="{Binding DataView}" AutoGenerateColumns="True" IsReadOnly="True" 
                                                                          Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC"
                                                                          HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="Transparent"
                                                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" 
                                                                          BorderThickness="0" RowHeight="35" FontSize="13" Foreground="#334155" Margin="5">
                                                                    <DataGrid.Resources>
                                                                        <Style TargetType="DataGridColumnHeader">
                                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                                            <Setter Property="Foreground" Value="#475569"/>
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            <Setter Property="Padding" Value="12,10"/>
                                                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                                        </Style>
                                                                        <Style TargetType="DataGridCell">
                                                                            <Setter Property="Padding" Value="12,0"/>
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="DataGridCell">
                                                                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                                                            <ContentPresenter VerticalAlignment="Center" />
                                                                                        </Border>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsSelected" Value="True">
                                                                                    <Setter Property="Background" Value="#E2E8F0"/>
                                                                                    <Setter Property="Foreground" Value="#0F172A"/>
                                                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                        <Style TargetType="DataGridRow">
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </DataGrid.Resources>
                                                                </DataGrid>
                                                            </DataTemplate>
                                                        </TabControl.ContentTemplate>
                                                    </TabControl>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKasiyerCikis}" Value="True">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                                <Border Background="White" BorderBrush="#FFC107" BorderThickness="2" Width="400" Padding="20" HorizontalAlignment="Center">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding StoreName}" HorizontalAlignment="Center" Foreground="#E53935" FontWeight="Bold"/>
                                                                        <TextBlock Text="** GÜN SONU HESABATI **" HorizontalAlignment="Center" Foreground="#E53935"/>
                                                                        <TextBlock Text="{Binding ReportDateTimeText}" HorizontalAlignment="Center" FontSize="11"/>
                                                                        
                                                                        <Separator Margin="0,10" BorderBrush="Black" BorderThickness="1"/>
                                                                        <TextBlock Text="SATIŞ XÜLASƏSİ" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,10"/>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="QRUP ADI" Grid.Column="0" FontWeight="Bold"/>
                                                                            <TextBlock Text="FAİZ" Grid.Column="1" FontWeight="Bold" Margin="10,0"/>
                                                                            <TextBlock Text="MƏBLƏĞ" Grid.Column="2" FontWeight="Bold"/>
                                                                        </Grid>
                                                                        <ItemsControl ItemsSource="{Binding CategorySales}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <TextBlock Text="{Binding GroupName}" Grid.Column="0"/>
                                                                                        <TextBlock Text="{Binding Percentage, StringFormat='{}% {0}'}" Grid.Column="1" Margin="10,0"/>
                                                                                        <TextBlock Text="{Binding Amount, StringFormat='{}{0:N2}'}" Grid.Column="2"/>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        
                                                                        <Grid Margin="0,10,0,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="ÜMUMİ SATIŞ" Grid.Column="0" FontWeight="Bold"/>
                                                                            <TextBlock Text="{Binding GrossSales, StringFormat='{}{0:N2} AZN'}" Grid.Column="1" FontWeight="Bold"/>
                                                                        </Grid>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="ÇEK ENDİRİMLƏRİ" Grid.Column="0"/>
                                                                            <TextBlock Text="{Binding CheckDiscounts, StringFormat='{}{0:N2} AZN'}" Grid.Column="1"/>
                                                                        </Grid>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="MƏHSUL ENDİRİMLƏRİ" Grid.Column="0"/>
                                                                            <TextBlock Text="{Binding ItemDiscounts, StringFormat='{}{0:N2} AZN'}" Grid.Column="1"/>
                                                                        </Grid>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="NAĞD ENDİRİMLƏR" Grid.Column="0"/>
                                                                            <TextBlock Text="{Binding CashDiscounts, StringFormat='{}{0:N2} AZN'}" Grid.Column="1"/>
                                                                        </Grid>
                                                                        
                                                                        <Separator Margin="0,5" BorderBrush="Black" BorderThickness="1"/>
                                                                        <Grid Margin="0,5,0,10">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="XALİS SATIŞ" Grid.Column="0" FontWeight="Bold"/>
                                                                            <TextBlock Text="{Binding NetSales, StringFormat='{}{0:N2} AZN'}" Grid.Column="1" FontWeight="Bold"/>
                                                                        </Grid>
                                                                        <Grid Margin="0,0,0,10">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="XİDMƏT HAQQI" Grid.Column="0" FontWeight="Bold"/>
                                                                            <TextBlock Text="{Binding ServiceFee, StringFormat='{}{0:N2} AZN'}" Grid.Column="1" FontWeight="Bold"/>
                                                                        </Grid>

                                                                        <Separator Margin="0,5" BorderBrush="Black" BorderThickness="1"/>
                                                                        <TextBlock Text="STATİSTİKA" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,10"/>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="ÜMUMİ ÇEK SAYI" Grid.Column="0"/>
                                                                            <TextBlock Text="{Binding TotalCheckCount, StringFormat='{}{0:N2}'}" Grid.Column="1"/>
                                                                        </Grid>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="ORTALAMA ÇEK" Grid.Column="0"/>
                                                                            <TextBlock Text="{Binding CheckAverage, StringFormat='{}{0:N2}'}" Grid.Column="1"/>
                                                                        </Grid>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="ÜMUMİ QONAQ" Grid.Column="0"/>
                                                                            <TextBlock Text="{Binding TotalGuests, StringFormat='{}{0:N2}'}" Grid.Column="1"/>
                                                                        </Grid>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="ORTALAMA QONAQ" Grid.Column="0"/>
                                                                            <TextBlock Text="{Binding GuestAverage, StringFormat='{}{0:N2}'}" Grid.Column="1"/>
                                                                        </Grid>

                                                                        <Separator Margin="0,5" BorderBrush="Black" BorderThickness="1"/>
                                                                        <TextBlock Text="SATIŞ BÖLGÜSÜ" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,10"/>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="SATIŞ NÖVÜ" Grid.Column="0" FontWeight="Bold"/>
                                                                            <TextBlock Text="SAY" Grid.Column="1" FontWeight="Bold" Margin="10,0"/>
                                                                            <TextBlock Text="MƏBLƏĞ" Grid.Column="2" FontWeight="Bold"/>
                                                                        </Grid>
                                                                        <ItemsControl ItemsSource="{Binding SalesTypes}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <TextBlock Text="{Binding SalesType}" Grid.Column="0"/>
                                                                                        <TextBlock Text="{Binding Count}" Grid.Column="1" Margin="10,0"/>
                                                                                        <TextBlock Text="{Binding Amount, StringFormat='{}{0:N2} AZN'}" Grid.Column="2"/>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>

                                                                        <Separator Margin="0,5" BorderBrush="Black" BorderThickness="1"/>
                                                                        <TextBlock Text="ÖDƏNİŞLƏR" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,10"/>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="ÖDƏNİŞ NÖVÜ" Grid.Column="0" FontWeight="Bold"/>
                                                                            <TextBlock Text="MƏBLƏĞ" Grid.Column="1" FontWeight="Bold"/>
                                                                        </Grid>
                                                                        <ItemsControl ItemsSource="{Binding Payments}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <TextBlock Text="{Binding PaymentName}" Grid.Column="0"/>
                                                                                        <TextBlock Text="{Binding Amount, StringFormat='{}{0:N2} AZN'}" Grid.Column="1"/>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>

                                                                        <Separator Margin="0,5" BorderBrush="Black" BorderThickness="1"/>
                                                                        <TextBlock Text="AÇIQ ÇEKLƏR" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,10"/>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="AÇIQ ÇEKLƏR" Grid.Column="0" FontWeight="Bold"/>
                                                                            <TextBlock Text="{Binding OpenChecksAmount, StringFormat='{}{0:N2} AZN'}" Grid.Column="1" FontWeight="Bold"/>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Border>
                                                            </ScrollViewer>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsHtmlReport}" Value="True">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <WebBrowser helpers:WebBrowserHelper.Html="{Binding HtmlContent}" Margin="10"/>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </Grid>
    </Grid>
</UserControl>
