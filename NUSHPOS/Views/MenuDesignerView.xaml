<UserControl x:Class="NUSHPOS.Views.MenuDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NUSHPOS.Views"
             xmlns:vm="clr-namespace:NUSHPOS.ViewModels"
             xmlns:converters="clr-namespace:NUSHPOS.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1000"
             Background="White">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:EqualityConverter x:Key="EqualityConverter"/>
        <!-- Item Button Style (Light Blue Gradient Rounded) -->
        <Style x:Key="PosGridButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#86b7db"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="5"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#e4f1fa" Offset="0.0"/>
                                    <GradientStop Color="#bfe0f8" Offset="0.5"/>
                                    <GradientStop Color="#a8d3f4" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" 
                                              Margin="6,4"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3da7eb"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#f0f7fd" Offset="0.0"/>
                                            <GradientStop Color="#cde6f9" Offset="0.5"/>
                                            <GradientStop Color="#bce0fb" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#9ecbf0" Offset="0.0"/>
                                            <GradientStop Color="#7eb8e8" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav Arrow Button Style -->
        <Style x:Key="NavSquareBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="BorderBrush" Value="#86b7db"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2c5a85"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#e4f1fa" Offset="0.0"/>
                                    <GradientStop Color="#bfe0f8" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3da7eb"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Tab Bar -->
            <RowDefinition Height="38"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════════
             TOP TAB HEADER
             ════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#f4f7fa" BorderBrush="#d5dfe8" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                <!-- Active Tab -->
                <Border Background="White" BorderBrush="#d5dfe8" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Height="32" Padding="14,0,10,0" Margin="0,0,5,-1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🍽️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="MENYU DİZAYNERİ" FontWeight="Bold" FontSize="12" Foreground="#333" VerticalAlignment="Center"/>
                        <Button Content="✕" Command="{Binding CloseCommand}" Margin="12,0,0,0" Background="Transparent" BorderThickness="0" Foreground="#888" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════
             MAIN CONTENT: LEFT GROUPS PANEL + RIGHT ITEMS GRID
             ════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <!-- Left Menu Groups (Width ~210) -->
                <ColumnDefinition Width="210"/>
                <!-- Right Menu Items Grid (Remaining) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT PANEL: MENU GROUPS ───────────────────────────── -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <!-- Top button: MENYU QRUPLARI -->
                    <RowDefinition Height="46"/>
                    <!-- Groups List -->
                    <RowDefinition Height="*"/>
                    <!-- Navigation Arrows -->
                    <RowDefinition Height="46"/>
                    <!-- Bottom button: QRUPLARI TƏNZİMLƏ -->
                    <RowDefinition Height="46"/>
                </Grid.RowDefinitions>

                <!-- Top Button: MENYU QRUPLARI -->
                <Button Grid.Row="0"
                        Content="MENYU QRUPLARI"
                        Command="{Binding LoadMenuGroupsCommand}"
                        FontWeight="Bold"
                        FontSize="13"
                        Foreground="#1f4f7b"
                        Height="38"
                        BorderBrush="#86b7db"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="18" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#ffffff" Offset="0.0"/>
                                        <GradientStop Color="#e4f1fa" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Menu Groups List -->
                <Border Grid.Row="1" BorderBrush="#bfd5ea" BorderThickness="1" Margin="0,8,0,8" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header bar -->
                        <Border Grid.Row="0" Background="#f1f5f9" BorderBrush="#d5dfe8" BorderThickness="0,0,0,1">
                            <TextBlock Text="▾" HorizontalAlignment="Left" Margin="6,2,0,0" Foreground="#555" FontSize="11"/>
                        </Border>

                        <!-- List Items -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding MenuGroups}"
                                 SelectedItem="{Binding SelectedMenuGroup}"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="▸" FontSize="11" Foreground="#3da7eb" VerticalAlignment="Center"
                                                   Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MenuGroupText}" FontSize="13" FontWeight="SemiBold" Foreground="#222" Margin="4,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="4,4"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#cbe5fc"/>
                                            <Setter Property="Foreground" Value="#003366"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#eaf4fd"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Navigation Arrows: 4 Square Buttons -->
                <Grid Grid.Row="2" Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="↑" Style="{StaticResource NavSquareBtn}" Command="{Binding MovePreviousGroupCommand}" ToolTip="Əvvəlki qrup"/>
                    <Button Grid.Column="1" Content="⤒" Style="{StaticResource NavSquareBtn}" Command="{Binding MoveFirstGroupCommand}" ToolTip="Birinci qrup"/>
                    <Button Grid.Column="2" Content="↓" Style="{StaticResource NavSquareBtn}" Command="{Binding MoveNextGroupCommand}" ToolTip="Sonrakı qrup"/>
                    <Button Grid.Column="3" Content="⤓" Style="{StaticResource NavSquareBtn}" Command="{Binding MoveLastGroupCommand}" ToolTip="Sonuncu qrup"/>
                </Grid>

                <!-- Bottom Button: QRUPLARI TƏNZİMLƏ -->
                <Button Grid.Row="3"
                        Content="QRUPLARI TƏNZİMLƏ"
                        Command="{Binding ManageGroupsCommand}"
                        FontWeight="Bold"
                        FontSize="12"
                        Foreground="#1f4f7b"
                        Height="38"
                        BorderBrush="#86b7db"
                        BorderThickness="1"
                        Cursor="Hand"
                        Margin="0,4,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="18" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#ffffff" Offset="0.0"/>
                                        <GradientStop Color="#e4f1fa" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ── RIGHT PANEL: MENU ITEM BUTTONS GRID ──────────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- 4x7 Buttons Grid (28 items) -->
                    <RowDefinition Height="*"/>
                    <!-- Bottom Controls: Page numbers + Save button -->
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <!-- 4 Columns x 7 Rows Grid -->
                <ItemsControl Grid.Row="0" ItemsSource="{Binding GridSlots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" Rows="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PosGridButtonStyle}"
                                    Command="{Binding DataContext.SlotClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="{Binding DisplayText}"
                                           FontWeight="SemiBold"
                                           FontSize="18"
                                           Foreground="#003366"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Bottom Row: Page Numbers (1..10) + Save & Close Button -->
                <Grid Grid.Row="1" Margin="4,8,4,0">
                    <Grid.ColumnDefinitions>
                        <!-- Page Number Buttons -->
                        <ColumnDefinition Width="*"/>
                        <!-- Save & Close Button -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Page numbers (1 to 10) -->
                    <ItemsControl Grid.Column="0" ItemsSource="{Binding Pages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Width="34" Height="34"
                                        Margin="2,0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="BorderBrush" Value="#86b7db"/>
                                            <Setter Property="Background" Value="#dce8f5"/>
                                            <Setter Property="Foreground" Value="#222"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <!-- Active Page Highlight (matches Page 1 in screenshot) -->
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                            <Binding Path="DataContext.SelectedPageIndex" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                            <Binding Path="."/>
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Background" Value="#3cb84a"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="#2f973c"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Save and Close Button (Green) -->
                    <Button Grid.Column="1"
                            Content="YADDA SAXLA VƏ BAĞLA"
                            Command="{Binding SaveAndCloseCommand}"
                            Background="#3cb84a"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="12"
                            Height="34"
                            Padding="16,0"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="3" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#32a140"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
