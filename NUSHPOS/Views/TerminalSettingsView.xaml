<UserControl x:Class="NUSHPOS.Views.TerminalSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="950"
             Background="#f0f4f9">

    <UserControl.Resources>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SettingInput" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="SettingCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="SmallActionBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Background" Value="#e2e8f0"/>
            <Setter Property="Foreground" Value="#1e293b"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SettingCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="65"/>
        </Grid.RowDefinitions>

        <!-- TOP TITLE -->
        <Border Grid.Row="0" Background="#1e2c43" CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TERMİNAL PARAMETRLƏRİ (STANSİYA SAZLAMALARI)" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Stansiya ID: 1 (SERVER)" Foreground="#93c5fd" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- TABBED SETTINGS -->
        <TabControl Grid.Row="1" Background="White" BorderBrush="#cbd5e1" BorderThickness="1">
            
            <!-- TAB 1: ÜMUMİ -->
            <TabItem Header="ÜMUMİ" FontWeight="Bold" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel MaxWidth="850" HorizontalAlignment="Left">
                        
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TERMİNAL №" Style="{StaticResource SettingLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource SettingInput}" Text="{Binding Station.StationID}" IsReadOnly="True" Background="#f1f5f9" FontWeight="Bold"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TERMİNAL ADI" Style="{StaticResource SettingLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource SettingInput}" Text="{Binding Station.StationName, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TERMİNAL ARXA FON ŞƏKLİ" Style="{StaticResource SettingLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource SettingInput}" Text="{Binding Station.BackgroundPicture, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Content="..." Style="{StaticResource SmallActionBtn}" Command="{Binding BrowseBackgroundPictureCommand}" Margin="4,0,0,0"/>
                            <Button Grid.Column="3" Content="Sil" Style="{StaticResource SmallActionBtn}" Command="{Binding ClearBackgroundPictureCommand}" Margin="4,0,0,0" Foreground="#e11d48"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TERMİNAL YAN PANEL ŞƏKLİ" Style="{StaticResource SettingLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource SettingInput}" Text="{Binding Station.SideBarPicture, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Content="..." Style="{StaticResource SmallActionBtn}" Command="{Binding BrowseSideBarPictureCommand}" Margin="4,0,0,0"/>
                            <Button Grid.Column="3" Content="Sil" Style="{StaticResource SmallActionBtn}" Command="{Binding ClearSideBarPictureCommand}" Margin="4,0,0,0" Foreground="#e11d48"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="İLK DAXİLOLMA EKRANI" Style="{StaticResource SettingLabel}"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                                      ItemsSource="{Binding LoginEntrances}"
                                      SelectedItem="{Binding Station.DefaultLoginEntrance}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="STANDART ZAL PLANI" Style="{StaticResource SettingLabel}"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                                      ItemsSource="{Binding TableGroups}"
                                      SelectedValuePath="TableGroupText"
                                      SelectedValue="{Binding Station.DefultTablePlan}"
                                      DisplayMemberPath="TableGroupText"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TERMİNAL İNTERFEYSİ (TEMA)" Style="{StaticResource SettingLabel}"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                                      ItemsSource="{Binding Skins}"
                                      SelectedItem="{Binding Station.SkinName}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TERMİNAL DİLİ" Style="{StaticResource SettingLabel}"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                                      ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding Station.Language}"/>
                        </Grid>

                        <Border Height="1" Background="#e2e8f0" Margin="0,12"/>

                        <CheckBox Content="ÇAĞRI MƏRKƏZİ REJİMİ AKTİV" IsChecked="{Binding Station.EnableCallCenterClient}" Style="{StaticResource SettingCheckBox}"/>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="380"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ÇAĞRI MƏRKƏZİ ÜNVANI" Style="{StaticResource SettingLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource SettingInput}" Text="{Binding Station.CallCenterClientAddress, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Content="Test Et" Style="{StaticResource SmallActionBtn}" Command="{Binding TestCallCenterAddressCommand}" Margin="6,0,0,0"/>
                        </Grid>

                        <CheckBox Content="MƏRKƏZİ ÇAĞRI MƏRKƏZİ AKTİV" IsChecked="{Binding Station.EnableCentralCallCenterClient}" Style="{StaticResource SettingCheckBox}"/>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="380"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="MƏRKƏZİ ÇAĞRI MƏRKƏZİ ÜNVANI" Style="{StaticResource SettingLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource SettingInput}" Text="{Binding Station.CentralCallCenterClientAddress, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Content="Test Et" Style="{StaticResource SmallActionBtn}" Command="{Binding TestCentralCallCenterAddressCommand}" Margin="6,0,0,0"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: KASSİR -->
            <TabItem Header="KASSİR" FontWeight="Bold" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel MaxWidth="850" HorizontalAlignment="Left">
                        <CheckBox Content="KASSİR REJİMİNİ AKTİVLƏŞDİR" IsChecked="{Binding Station.ActivateCashier}" Style="{StaticResource SettingCheckBox}"/>
                        <CheckBox Content="SON KASSİRİ YADDA SAXLA" IsChecked="{Binding Station.RememberCashier}" Style="{StaticResource SettingCheckBox}"/>
                        <CheckBox Content="ÇEKDƏN MƏHSUL SİLİNMƏSİNƏ ŞİFRƏ TƏLƏB ET" IsChecked="{Binding Station.AskPasswordForReduce}" Style="{StaticResource SettingCheckBox}"/>
                        <CheckBox Content="KASSA SİYİRMƏSİ DÜYMƏSİNİ GÖSTƏR" IsChecked="{Binding Station.ShowCashTrayButton}" Style="{StaticResource SettingCheckBox}"/>
                        <CheckBox Content="SİYİRMƏ AÇIQ OLARKƏN SATIŞI DAYANDIR" IsChecked="{Binding Station.DisableSaleOnOpenCashTray}" Style="{StaticResource SettingCheckBox}"/>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="EKRAN KİLİDLƏNMƏ VAXTI (SANİYƏ)" Style="{StaticResource SettingLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource SettingInput}" Text="{Binding Station.TimeOutScreenLock, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="2" Text=" san. (0 = deaktiv)" VerticalAlignment="Center" Foreground="#64748b" FontSize="11" Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: XİDMƏT -->
            <TabItem Header="XİDMƏT" FontWeight="Bold" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <Grid MaxWidth="850" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="ƏSAS EKRAN DÜYMƏLƏRİ" FontWeight="Bold" Foreground="#1e2c43" FontSize="13" Margin="0,0,0,8"/>
                            <CheckBox Content="Masada Xidmət Düyməsi" IsChecked="{Binding Station.ShowDineInButton}" Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Götür-Apar (Paket) Düyməsi" IsChecked="{Binding Station.ShowTakeOutButton}" Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Drive-Thru Düyməsi" IsChecked="{Binding Station.ShowDriveThruButton}" Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Çatdırılma Düyməsi" IsChecked="{Binding Station.ShowDeliveryButton}" Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Çekləri Çağırma Düyməsi" IsChecked="{Binding Station.ShowRecallButton}" Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Kuryer Statusu Düyməsi" IsChecked="{Binding Station.ShowDriverStatusButton}" Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Əməliyyatlar Düyməsi" IsChecked="{Binding Station.ShowOperationsButton}" Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Arxa Ofis Düyməsi" IsChecked="{Binding Station.ShowBackOfficeButton}" Style="{StaticResource SettingCheckBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="SÜRƏTLİ XİDMƏT VƏ DAVRANIŞLAR" FontWeight="Bold" Foreground="#1e2c43" FontSize="13" Margin="0,0,0,8"/>
                            <CheckBox Content="Masada Sürətli Xidmət" IsChecked="{Binding Station.ShowQuickServiceDineIn}" Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Paketdə Sürətli Xidmət" IsChecked="{Binding Station.ShowQuickServiceTakeOut}" Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Drive-Thru Sürətli Xidmət" IsChecked="{Binding Station.ShowQuickServiceDriveThru}" Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Çatdırılmada Sürətli Xidmət" IsChecked="{Binding Station.ShowQuickServiceDelivery}" Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Paketdə Satış Ekranında Qal" IsChecked="{Binding Station.StayInOrderScreenTakeOut}" Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Masada Zal Planında Qal" IsChecked="{Binding Station.StayTablePlanInDineIn}" Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Masada 'OK' Düyməsini Gizlət" IsChecked="{Binding Station.HideOkButtonOnDineIn}" Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Çatdırılmada 'OK' Düyməsini Gizlət" IsChecked="{Binding Station.HideOkButtonOnDelivery}" Style="{StaticResource SettingCheckBox}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: ÇAP QURĞULARI -->
            <TabItem Header="ÇAP QURĞULARI" FontWeight="Bold" FontSize="12">
                <TabControl Background="White" BorderBrush="#cbd5e1" BorderThickness="0,1,0,0">
                    
                    <!-- SUB-TAB 1: ÜMUMİ PRİNTERLƏR -->
                    <TabItem Header="ÜMUMİ PRİNTERLƏR" FontWeight="SemiBold" FontSize="11">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                            <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                                <!-- Column Headers -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="—— PRİNTER ADI ——" FontSize="11" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="—— DİZAYN ADI ——" FontSize="11" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                                </Grid>

                                <!-- HESAB PRİNTERİ -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="HESAB PRİNTERİ" Style="{StaticResource SettingLabel}"/>
                                    <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}" Margin="0,0,6,0"
                                              ItemsSource="{Binding Printers}"
                                              SelectedValuePath="PrinterID"
                                              SelectedValue="{Binding PrinterSettings.CheckPrinterID}"
                                              DisplayMemberPath="PrinterName"/>
                                    <ComboBox Grid.Column="2" Style="{StaticResource SettingCombo}" Margin="0,0,6,0"
                                              ItemsSource="{Binding PrinterDesigns}"
                                              SelectedValuePath="DesignName"
                                              SelectedValue="{Binding PrinterSettings.CheckDesignPath}"
                                              DisplayMemberPath="DesignName"
                                              IsEditable="True"/>
                                    <Button Grid.Column="3" Content="DİZAYN ET" Command="{Binding DesignReceiptCommand}" Style="{StaticResource SmallActionBtn}" Width="90" Background="#bae6fd" Foreground="#0369a1" FontWeight="Bold"/>
                                </Grid>

                                <!-- PAKET PRİNTERİ -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="PAKET PRİNTERİ" Style="{StaticResource SettingLabel}"/>
                                    <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}" Margin="0,0,6,0"
                                              ItemsSource="{Binding Printers}"
                                              SelectedValuePath="PrinterID"
                                              SelectedValue="{Binding PrinterSettings.DeliveryPrinterID}"
                                              DisplayMemberPath="PrinterName"/>
                                    <ComboBox Grid.Column="2" Style="{StaticResource SettingCombo}" Margin="0,0,6,0"
                                              ItemsSource="{Binding PrinterDesigns}"
                                              SelectedValuePath="DesignName"
                                              SelectedValue="{Binding PrinterSettings.DeliveryDesignPath}"
                                              DisplayMemberPath="DesignName"
                                              IsEditable="True"/>
                                </Grid>

                                <!-- 2. PAKET PRİNTERİ -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="2. PAKET PRİNTERİ" Style="{StaticResource SettingLabel}"/>
                                    <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}" Margin="0,0,6,0"
                                              ItemsSource="{Binding Printers}"
                                              SelectedValuePath="PrinterName"
                                              SelectedValue="{Binding PrinterSettings.DeliveryAltPrinterName}"
                                              DisplayMemberPath="PrinterName"/>
                                    <ComboBox Grid.Column="2" Style="{StaticResource SettingCombo}" Margin="0,0,6,0"
                                              ItemsSource="{Binding PrinterDesigns}"
                                              SelectedValuePath="DesignName"
                                              SelectedValue="{Binding PrinterSettings.DeliveryAltDesignPath}"
                                              DisplayMemberPath="DesignName"
                                              IsEditable="True"/>
                                </Grid>

                                <!-- RAPOR (POS PRİNTERİ) -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="HESABAT ( POS PRİNTERİ )" Style="{StaticResource SettingLabel}"/>
                                    <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}" Margin="0,0,6,0"
                                              ItemsSource="{Binding Printers}"
                                              SelectedValuePath="PrinterID"
                                              SelectedValue="{Binding PrinterSettings.ReportPrinterID}"
                                              DisplayMemberPath="PrinterName"/>
                                    <ComboBox Grid.Column="2" Style="{StaticResource SettingCombo}" Margin="0,0,6,0"
                                              ItemsSource="{Binding PrinterDesigns}"
                                              SelectedValuePath="DesignName"
                                              SelectedValue="{Binding PrinterSettings.ReportDesignPath}"
                                              DisplayMemberPath="DesignName"
                                              IsEditable="True"/>
                                </Grid>

                                <!-- RAPOR (A4 PRİNTERİ) -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="HESABAT ( A4 PRİNTERİ )" Style="{StaticResource SettingLabel}"/>
                                    <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}" Margin="0,0,6,0"
                                              ItemsSource="{Binding Printers}"
                                              SelectedValuePath="PrinterID"
                                              SelectedValue="{Binding PrinterSettings.ReportA4PrinterID}"
                                              DisplayMemberPath="PrinterName"/>
                                    <ComboBox Grid.Column="2" Style="{StaticResource SettingCombo}" Margin="0,0,6,0"
                                              ItemsSource="{Binding PrinterDesigns}"
                                              SelectedValuePath="DesignName"
                                              SelectedValue="{Binding PrinterSettings.ReportA4DesignPath}"
                                              DisplayMemberPath="DesignName"
                                              IsEditable="True"/>
                                </Grid>

                                <!-- ETİKET PRİNTERİ -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ETİKET PRİNTERİ" Style="{StaticResource SettingLabel}"/>
                                    <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}" Margin="0,0,6,0"
                                              ItemsSource="{Binding Printers}"
                                              SelectedValuePath="PrinterID"
                                              SelectedValue="{Binding PrinterSettings.LabelPrinterID}"
                                              DisplayMemberPath="PrinterName"/>
                                    <ComboBox Grid.Column="2" Style="{StaticResource SettingCombo}" Margin="0,0,6,0"
                                              ItemsSource="{Binding PrinterDesigns}"
                                              SelectedValuePath="DesignName"
                                              SelectedValue="{Binding PrinterSettings.LabelDesignPath}"
                                              DisplayMemberPath="DesignName"
                                              IsEditable="True"/>
                                </Grid>

                                <!-- XƏRC QƏBZİ (İADƏ) PRİNTERİ -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="XƏRC QƏBZİ (İADƏ) PRİNTERİ" Style="{StaticResource SettingLabel}"/>
                                    <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}" Margin="0,0,6,0"
                                              ItemsSource="{Binding Printers}"
                                              SelectedValuePath="PrinterID"
                                              SelectedValue="{Binding PrinterSettings.ReturnPrinterID}"
                                              DisplayMemberPath="PrinterName"/>
                                    <ComboBox Grid.Column="2" Style="{StaticResource SettingCombo}" Margin="0,0,6,0"
                                              ItemsSource="{Binding PrinterDesigns}"
                                              SelectedValuePath="DesignName"
                                              SelectedValue="{Binding PrinterSettings.ReturnDesignPath}"
                                              DisplayMemberPath="DesignName"
                                              IsEditable="True"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- SUB-TAB 2: MƏTBƏX / BAR -->
                    <TabItem Header="MƏTBƏX / BAR" FontWeight="SemiBold" FontSize="11">
                        <Grid Margin="12">
                            <TabControl Background="White" BorderBrush="#cbd5e1" BorderThickness="1">
                                <!-- SƏHİFƏ 1 (1-10) -->
                                <TabItem Header="SƏHİFƏ 1" FontWeight="Bold" FontSize="11">
                                    <DataGrid ItemsSource="{Binding KitchenSlotsPage1}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              GridLinesVisibility="All"
                                              HorizontalGridLinesBrush="#e2e8f0"
                                              VerticalGridLinesBrush="#e2e8f0"
                                              HeadersVisibility="Column"
                                              RowHeight="30"
                                              FontSize="12"
                                              BorderThickness="0"
                                              Background="White">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="NO" Binding="{Binding SlotNo}" Width="50" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="SAZLAMA ADI" Binding="{Binding SlotName}" Width="160"/>
                                            <DataGridTemplateColumn Header="PRİNTER ADI" Width="220">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.Printers, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  SelectedValuePath="PrinterID"
                                                                  SelectedValue="{Binding PrinterID, UpdateSourceTrigger=PropertyChanged}"
                                                                  DisplayMemberPath="PrinterName"
                                                                  Height="26"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="DİZAYN" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.PrinterDesigns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  SelectedValuePath="DesignName"
                                                                  SelectedValue="{Binding DesignPath, UpdateSourceTrigger=PropertyChanged}"
                                                                  DisplayMemberPath="DesignName"
                                                                  IsEditable="True"
                                                                  Height="26"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>

                                <!-- SƏHİFƏ 2 (11-20) -->
                                <TabItem Header="SƏHİFƏ 2" FontWeight="Bold" FontSize="11">
                                    <DataGrid ItemsSource="{Binding KitchenSlotsPage2}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              GridLinesVisibility="All"
                                              HorizontalGridLinesBrush="#e2e8f0"
                                              VerticalGridLinesBrush="#e2e8f0"
                                              HeadersVisibility="Column"
                                              RowHeight="30"
                                              FontSize="12"
                                              BorderThickness="0"
                                              Background="White">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="NO" Binding="{Binding SlotNo}" Width="50" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="SAZLAMA ADI" Binding="{Binding SlotName}" Width="160"/>
                                            <DataGridTemplateColumn Header="PRİNTER ADI" Width="220">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.Printers, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  SelectedValuePath="PrinterID"
                                                                  SelectedValue="{Binding PrinterID, UpdateSourceTrigger=PropertyChanged}"
                                                                  DisplayMemberPath="PrinterName"
                                                                  Height="26"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="DİZAYN" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.PrinterDesigns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  SelectedValuePath="DesignName"
                                                                  SelectedValue="{Binding DesignPath, UpdateSourceTrigger=PropertyChanged}"
                                                                  DisplayMemberPath="DesignName"
                                                                  IsEditable="True"
                                                                  Height="26"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </TabItem>

                    <!-- SUB-TAB 3: SİFARİŞ / QƏBZ PRİNTERİ -->
                    <TabItem Header="SİFARİŞ / QƏBZ PRİNTERİ" FontWeight="SemiBold" FontSize="11">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                            <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="—— PRİNTER ADI ——" FontSize="11" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="—— DİZAYN ADI ——" FontSize="11" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SİFARİŞ / QƏBZ PRİNTERİ" Style="{StaticResource SettingLabel}"/>
                                    <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}" Margin="0,0,6,0"
                                              ItemsSource="{Binding Printers}"
                                              SelectedValuePath="PrinterID"
                                              SelectedValue="{Binding PrinterSettings.AdditionPrinterID}"
                                              DisplayMemberPath="PrinterName"/>
                                    <ComboBox Grid.Column="2" Style="{StaticResource SettingCombo}" Margin="0,0,6,0"
                                              ItemsSource="{Binding PrinterDesigns}"
                                              SelectedValuePath="DesignName"
                                              SelectedValue="{Binding PrinterSettings.AdditionDesignPath}"
                                              DisplayMemberPath="DesignName"
                                              IsEditable="True"/>
                                </Grid>

                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ÜST BOŞLUQ SƏTİR SAYI" Style="{StaticResource SettingLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource SettingInput}" Text="{Binding PrinterSettings.AdditionTopFeed, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SƏHİFƏDƏKİ DETAL SƏTİR SAYI" Style="{StaticResource SettingLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource SettingInput}" Text="{Binding PrinterSettings.AdditionRowCount, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- SUB-TAB 4: FAKTURA PRİNTERİ -->
                    <TabItem Header="FAKTURA PRİNTERİ" FontWeight="SemiBold" FontSize="11">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                            <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="—— PRİNTER ADI ——" FontSize="11" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="—— DİZAYN ADI ——" FontSize="11" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="FAKTURA PRİNTERİ" Style="{StaticResource SettingLabel}"/>
                                    <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}" Margin="0,0,6,0"
                                              ItemsSource="{Binding Printers}"
                                              SelectedValuePath="PrinterID"
                                              SelectedValue="{Binding PrinterSettings.InvoicePrinterID}"
                                              DisplayMemberPath="PrinterName"/>
                                    <ComboBox Grid.Column="2" Style="{StaticResource SettingCombo}" Margin="0,0,6,0"
                                              ItemsSource="{Binding PrinterDesigns}"
                                              SelectedValuePath="DesignName"
                                              SelectedValue="{Binding PrinterSettings.InvoiceDesignPath}"
                                              DisplayMemberPath="DesignName"
                                              IsEditable="True"/>
                                </Grid>

                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ÜST BOŞLUQ SƏTİR SAYI" Style="{StaticResource SettingLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource SettingInput}" Text="{Binding PrinterSettings.InvoiceTopFeed, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SƏHİFƏDƏKİ DETAL SƏTİR SAYI" Style="{StaticResource SettingLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource SettingInput}" Text="{Binding PrinterSettings.InvoiceRowCount, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- SUB-TAB 5: ÇAP PARAMETRLƏRİ -->
                    <TabItem Header="ÇAP PARAMETRLƏRİ" FontWeight="SemiBold" FontSize="11">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                            <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                                <CheckBox Content="BU TERMİNALDA VERİLƏN MASA SİFARİŞLƏRİNİ MƏTBƏX PRİNTERİNDƏ ÇAP ET" IsChecked="{Binding PrinterSettings.PrintDineInOrdersKitchen}" Style="{StaticResource SettingCheckBox}"/>
                                <CheckBox Content="BU TERMİNALDA VERİLƏN BAR SİFARİŞLƏRİNİ MƏTBƏX PRİNTERİNDƏ ÇAP ET" IsChecked="{Binding PrinterSettings.PrintBarTableOrdersKitchen}" Style="{StaticResource SettingCheckBox}"/>
                                <CheckBox Content="BU TERMİNALDA VERİLƏN AL GÖTÜR (PAKET) SİFARİŞLƏRİNİ MƏTBƏX PRİNTERİNDƏ ÇAP ET" IsChecked="{Binding PrinterSettings.PrintTakeOutOrdersKitchen}" Style="{StaticResource SettingCheckBox}"/>
                                <CheckBox Content="BU TERMİNALDA VERİLƏN TEZGAH (SÜRƏTLİ) SİFARİŞLƏRİNİ MƏTBƏX PRİNTERİNDƏ ÇAP ET" IsChecked="{Binding PrinterSettings.PrintDriveThruOrdersKitchen}" Style="{StaticResource SettingCheckBox}"/>
                                <CheckBox Content="BU TERMİNALDA VERİLƏN ÇATDIRILMA SİFARİŞLƏRİNİ MƏTBƏX PRİNTERİNDƏ ÇAP ET" IsChecked="{Binding PrinterSettings.PrintDeliveryOrdersKitchen}" Style="{StaticResource SettingCheckBox}"/>

                                <Border Height="1" Background="#e2e8f0" Margin="0,12"/>

                                <CheckBox Content="HESAB ÇIXARIŞINDA LƏĞV EDİLMİŞ SƏTİRLƏRİ DƏ ÇAP ET" IsChecked="{Binding Station.PrintVoidedLinesOnGuestCheck}" Style="{StaticResource SettingCheckBox}"/>
                                <CheckBox Content="MƏTBƏX ÇIXARIŞINDA 2-Cİ DİLİ İSTİFADƏ ET" IsChecked="{Binding Station.UseSecondLangOnKitchenPrint}" Style="{StaticResource SettingCheckBox}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </TabItem>

            <!-- TAB 5: PORT SAZLAMALARI -->
            <TabItem Header="PORT SAZLAMALARI" FontWeight="Bold" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel MaxWidth="850" HorizontalAlignment="Left">
                        
                        <TextBlock Text="MÜŞTƏRİ GÖSTƏRİCİSİ (DISPLAY)" FontWeight="Bold" Foreground="#1e2c43" FontSize="13" Margin="0,0,0,8"/>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PORT NÖMRƏSİ" Style="{StaticResource SettingLabel}"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                                      ItemsSource="{Binding ComPorts}"
                                      SelectedItem="{Binding Station.CustomerDisplayPortNo}"/>
                        </Grid>

                        <Border Height="1" Background="#e2e8f0" Margin="0,10"/>
                        <TextBlock Text="ELEKTRON TƏRƏZİ" FontWeight="Bold" Foreground="#1e2c43" FontSize="13" Margin="0,0,0,8"/>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TƏRƏZİ 1 PORT" Style="{StaticResource SettingLabel}"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                                      ItemsSource="{Binding ComPorts}"
                                      SelectedItem="{Binding Station.WeightScale1PortNo}"/>
                            <TextBlock Grid.Column="2" Text="SÜRƏT (BAUD)" Style="{StaticResource SettingLabel}" Margin="12,0,0,0"/>
                            <ComboBox Grid.Column="3" Style="{StaticResource SettingCombo}"
                                      ItemsSource="{Binding BaudRates}"
                                      SelectedItem="{Binding Station.WeightScale1BaudRate}"/>
                        </Grid>

                        <Border Height="1" Background="#e2e8f0" Margin="0,10"/>
                        <TextBlock Text="KASSA APARATI / CALLER ID" FontWeight="Bold" Foreground="#1e2c43" FontSize="13" Margin="0,0,0,8"/>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="KASSA APARATI PORT" Style="{StaticResource SettingLabel}"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                                      ItemsSource="{Binding ComPorts}"
                                      SelectedItem="{Binding Station.CashRegisterPortNo}"/>
                            <TextBlock Grid.Column="2" Text="CALLER ID PORT" Style="{StaticResource SettingLabel}" Margin="12,0,0,0"/>
                            <ComboBox Grid.Column="3" Style="{StaticResource SettingCombo}"
                                      ItemsSource="{Binding ComPorts}"
                                      SelectedItem="{Binding Station.CallerIDPort}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 6: MÜŞTƏRİ EKRANI -->
            <TabItem Header="MÜŞTƏRİ EKRANI" FontWeight="Bold" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel MaxWidth="850" HorizontalAlignment="Left">
                        <CheckBox Content="MÜŞTƏRİ MEDİA EKRANINI AKTİVLƏŞDİR" IsChecked="{Binding Station.MediaDisplayIsActive}" Style="{StaticResource SettingCheckBox}"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ŞRİFT ÖLÇÜSÜ" Style="{StaticResource SettingLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource SettingInput}" Text="{Binding Station.MediaDisplayFontSize, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="340"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="KASSA BAĞLI OLARKƏN MƏTN" Style="{StaticResource SettingLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource SettingInput}" Text="{Binding Station.MediaDisplayClosedMessage, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="340"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ÖDƏNİŞ BİTƏNDƏ MƏTN" Style="{StaticResource SettingLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource SettingInput}" Text="{Binding Station.MediaDisplayMoneyOver, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <CheckBox Content="Kombo məhsulları ekranda göstər" IsChecked="{Binding Station.ShowComboOnMediaDisplay}" Style="{StaticResource SettingCheckBox}"/>
                        <CheckBox Content="Mesaj və modifikatorları ekranda göstər" IsChecked="{Binding Station.ShowMenuModifierOnMediaDisplay}" Style="{StaticResource SettingCheckBox}"/>
                        <CheckBox Content="Məhsul şəkillərini ekranda göstər" IsChecked="{Binding Station.ShowSidePictureOnMediaDisplay}" Style="{StaticResource SettingCheckBox}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- BOTTOM ACTION BUTTONS -->
        <Border Grid.Row="2" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1,0,1,1" Padding="14,10">
            <Grid>
                <!-- İMTİNA -->
                <Button Content="İMTİNA"
                        Command="{Binding CancelCommand}"
                        Background="#e11d48"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        Width="160"
                        Height="44"
                        HorizontalAlignment="Left"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="4" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- YADDA SAXLA VƏ BAĞLA -->
                <Button Content="YADDA SAXLA VƏ BAĞLA"
                        Command="{Binding SaveAndCloseCommand}"
                        Background="#16a34a"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        Width="220"
                        Height="44"
                        HorizontalAlignment="Right"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="4" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

    </Grid>
</UserControl>