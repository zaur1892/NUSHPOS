<UserControl x:Class="NUSHPOS.Views.BackOfficeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NUSHPOS.Views"
             xmlns:viewmodels="clr-namespace:NUSHPOS.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1024"
             Background="White">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type viewmodels:CompanySettingsViewModel}">
            <local:CompanySettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:TerminalSettingsViewModel}">
            <local:TerminalSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:EmployeeSettingsViewModel}">
            <local:EmployeeSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:MenuDesignerViewModel}">
            <local:MenuDesignerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SecuritySettingsViewModel}">
            <local:SecuritySettingsView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="#1e2c43">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,15,0,0">
                    <!-- Header -->
                    <Grid Margin="15,0,15,15">
                        <TextBlock Text="ARXA OFİS" Foreground="White" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                        <Button Content="Geri Qayıt" Background="#f03041" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="Bold" Padding="8,4" HorizontalAlignment="Right" Command="{Binding NavigateBackCommand}" Cursor="Hand"/>
                    </Grid>

                    <!-- Submenu Header for Active Category -->
                    <Border Background="#243450" Padding="12,8" Margin="0,0,0,5">
                        <Grid>
                            <TextBlock Text="Ümumi Sazlamalar" Foreground="#8ec3eb" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="«" Foreground="#8ec3eb" HorizontalAlignment="Right" FontSize="14"/>
                        </Grid>
                    </Border>

                    <!-- Sub-items for Ümumi Sazlamalar -->
                    <StackPanel Background="#1b283d" Margin="0,0,0,10">
                        <Button Content="🏢  Müəssisə Sazlamaları" Command="{Binding OpenCompanySettingsCommand}" Height="40" Background="Transparent" Foreground="#ccc" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,0,0,0" FontSize="12" Cursor="Hand"/>
                        <Button Content="💻  Terminal Sazlamaları" Command="{Binding OpenTerminalSettingsCommand}" Height="40" Background="Transparent" Foreground="#ccc" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,0,0,0" FontSize="12" Cursor="Hand"/>
                        <Button Content="🔐  Təhlükəsizlik Sazlamaları" Command="{Binding OpenSecuritySettingsCommand}" Height="40" Background="#2e4368" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,0,0,0" FontWeight="Bold" FontSize="12" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Main Category Buttons -->
                    <Border Height="1" Background="#2c3e5e" Margin="10,0,10,10"/>
                    <Button Content="⚙️  Ümumi Sazlamalar" Command="{Binding OpenCompanySettingsCommand}" Height="44" Background="#283a57" Foreground="#3da7eb" BorderThickness="0" HorizontalContentAlignment="Left" Padding="16,0,0,0" Margin="0,1" FontWeight="Bold" FontSize="13" Cursor="Hand"/>
                    <Button Content="📋  Menyu Sazlamaları" Command="{Binding OpenMenuDesignerCommand}" Height="44" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="16,0,0,0" Margin="0,1" FontSize="13" Cursor="Hand"/>
                    <Button Content="👤  Əməkdaş Sazlamaları" Command="{Binding OpenEmployeeSettingsCommand}" Height="44" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="16,0,0,0" Margin="0,1" FontSize="13" Cursor="Hand"/>
                    <Button Content="🪑  Masa Sazlamaları" Command="{Binding OpenTableSettingsCommand}" Height="44" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="16,0,0,0" Margin="0,1" FontSize="13" Cursor="Hand"/>
                    <Button Content="🏷️  % Endirim, Kampaniya, Ödəniş" Command="{Binding OpenDiscountSettingsCommand}" Height="44" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="16,0,0,0" Margin="0,1" FontSize="13" Cursor="Hand"/>
                    <Button Content="⚡  Əməliyyatlar" Command="{Binding OpenOperationsCommand}" Height="44" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="16,0,0,0" Margin="0,1" FontSize="13" Cursor="Hand"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>

            <!-- TOP NAV -->
            <Border Grid.Row="0" Background="#dbe8f9">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="Modullar" Background="Transparent" BorderThickness="0" Margin="5" FontSize="13" Foreground="#333"/>
                    <Button Content="Texniki Xidmət" Background="Transparent" BorderThickness="0" Margin="5" FontSize="13" Foreground="#333"/>
                    <Button Content="Əməliyyatlar" Background="Transparent" BorderThickness="0" Margin="5" FontSize="13" Foreground="#333"/>
                    <Button Content="Hesabatlar" Background="Transparent" BorderThickness="0" Margin="5" FontSize="13" Foreground="#333"/>
                </StackPanel>
            </Border>

            <!-- CENTRAL CONTENT & RIGHT DASHBOARD -->
            <Grid Grid.Row="1">
                <ContentControl Content="{Binding CurrentSubView}" />

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSubView}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <!-- Center: Logo -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,40,0,0">
                        <TextBlock Text="NUSHPOS" FontSize="60" Foreground="#00b4ff" FontFamily="Segoe UI Light" Margin="0,-10,0,0"/>
                    </StackPanel>

                    <!-- Right Dashboard Blocks -->
                    <StackPanel Grid.Column="1" Margin="10,10,10,0">
                        <!-- DB Size -->
                        <Border Background="#f03041" CornerRadius="3" Height="80" Margin="0,0,0,10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DbSize}" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Baza Həcmi" Foreground="White" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Customer Count -->
                        <Border Background="#3cb84a" CornerRadius="3" Height="80" Margin="0,0,0,10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CustomerCount}" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Müştəri Sayı" Foreground="White" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Order Count -->
                        <Border Background="#3da7eb" CornerRadius="3" Height="80" Margin="0,0,0,10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding OrderCount}" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Sifariş Sayı" Foreground="White" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Employee Count -->
                        <Border Background="#9e2f9d" CornerRadius="3" Height="80" Margin="0,0,0,10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding EmployeeCount}" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Əməkdaş Sayı" Foreground="White" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- STATUS BAR -->
            <Border Grid.Row="2" Background="#666" BorderThickness="0,3,0,0" BorderBrush="#3da7eb">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Baza : " Foreground="White" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="{Binding DbPath}" Foreground="White" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Son Yedəkləmə : " Foreground="White" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="{Binding BackupDate}" Foreground="White" FontSize="12" Margin="0,0,20,0"/>
                        
                        <TextBlock Text="Lisenziyalı müştəri : " Foreground="White" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="{Binding LicenseCustomer}" Foreground="White" FontSize="12" Margin="0,0,20,0"/>
                        
                        <TextBlock Text="Server : " Foreground="White" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ServerName}" Foreground="White" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
