<Window x:Class="NUSHPOS.Views.Dialogs.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payment" Height="400" Width="500" 
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" 
        ResizeMode="NoResize"
        Background="#E6F2FF">
    
    <Border BorderBrush="#619EE2" BorderThickness="2" Background="#E6F2FF">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Border Background="#7484B6" Margin="10,10,10,0" CornerRadius="4">
                <TextBlock Text="ALINAN ÖDEME TUTARI" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            
            <Grid Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Numpad & Input -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="White" BorderBrush="#8BB5DA" BorderThickness="1" Margin="0,0,5,0" Padding="10,0">
                            <TextBlock Text="{Binding AmountTenderedString}" FontSize="36" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Border>
                        <Button Grid.Column="1" Content="&lt;" Command="{Binding ClearCommand}" FontSize="24" FontWeight="Bold" Background="#B0D4F1" Foreground="#33597D" BorderThickness="1" BorderBrush="#8BB5DA"/>
                    </Grid>
                    
                    <UniformGrid Grid.Row="1" Columns="3" Rows="4" Margin="0,5,0,0">
                        <UniformGrid.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Margin" Value="2"/>
                                <Setter Property="FontSize" Value="36"/>
                                <Setter Property="Foreground" Value="#33597D"/>
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#D1E8FA" Offset="0"/>
                                            <GradientStop Color="#ABCDEF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="BorderBrush" Value="#8BB5DA"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Style>
                        </UniformGrid.Resources>
                        <Button Content="7" Command="{Binding NumpadCommand}" CommandParameter="7"/>
                        <Button Content="8" Command="{Binding NumpadCommand}" CommandParameter="8"/>
                        <Button Content="9" Command="{Binding NumpadCommand}" CommandParameter="9"/>
                        <Button Content="4" Command="{Binding NumpadCommand}" CommandParameter="4"/>
                        <Button Content="5" Command="{Binding NumpadCommand}" CommandParameter="5"/>
                        <Button Content="6" Command="{Binding NumpadCommand}" CommandParameter="6"/>
                        <Button Content="1" Command="{Binding NumpadCommand}" CommandParameter="1"/>
                        <Button Content="2" Command="{Binding NumpadCommand}" CommandParameter="2"/>
                        <Button Content="3" Command="{Binding NumpadCommand}" CommandParameter="3"/>
                        <Button Content="İPTAL" Command="{Binding CancelCommand}" Background="#E72C2C" Foreground="White" FontSize="24"/>
                        <Button Content="0" Command="{Binding NumpadCommand}" CommandParameter="0"/>
                        <Button Content="TAMAM" Command="{Binding ProcessPaymentCommand}" Background="#4CAF50" Foreground="White" FontSize="20"/>
                    </UniformGrid>
                </Grid>
                
                <!-- Quick Amount & Due Amount -->
                <Grid Grid.Column="1" Margin="10,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Background="#4CAF50" BorderBrush="#388E3C" BorderThickness="1" Padding="10" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding ExactAmountCommand}"/>
                        </Border.InputBindings>
                        <TextBlock Text="{Binding AmountDueString}" Foreground="White" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <Button Content="100,00" Command="{Binding QuickAmountCommand}" CommandParameter="100" FontSize="28" Foreground="#33597D" Background="#D1E8FA" BorderBrush="#8BB5DA" BorderThickness="1" Margin="0,0,0,5" Height="60"/>
                        <Button Content="200,00" Command="{Binding QuickAmountCommand}" CommandParameter="200" FontSize="28" Foreground="#33597D" Background="#D1E8FA" BorderBrush="#8BB5DA" BorderThickness="1" Height="60"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
