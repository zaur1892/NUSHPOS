<Window x:Class="NUSHPOS.Views.Dialogs.PhoneEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telefon Girişi"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="400" Height="530"
        KeyDown="Window_KeyDown">

    <!-- Outer Shadow Border -->
    <Border Background="#F1F5F9" BorderBrush="#0284C7" BorderThickness="2" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="15" ShadowDepth="4"/>
        </Border.Effect>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/> <!-- Header -->
                <RowDefinition Height="65"/> <!-- Display + Backspace -->
                <RowDefinition Height="*"/>  <!-- Keypad -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Margin="0,0,0,10">
                <TextBlock Text="TELEFON NÖMRƏSİNİ DAXİL EDİN" 
                           Foreground="#FFFFFF" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Display & Backspace (Clean, fully visible, razor-sharp) -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#0284C7" BorderThickness="2" CornerRadius="8" Margin="0,0,8,0">
                    <TextBox x:Name="txtPhone" 
                             FontSize="28" 
                             FontWeight="Bold" 
                             Foreground="#0F172A"
                             CaretBrush="#0284C7"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center" 
                             HorizontalContentAlignment="Center"
                             BorderThickness="0" 
                             Background="Transparent"
                             Padding="4,2"
                             Focusable="True">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Border>

                <!-- Backspace Button -->
                <Button Grid.Column="1" 
                        Click="BtnBackspace_Click" 
                        Background="#0284C7" 
                        Foreground="White" 
                        FontSize="24" 
                        FontWeight="Bold" 
                        BorderThickness="0" 
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" x:Name="bd">
                                <TextBlock Text="⌫" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Numeric Keypad -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.Resources>
                    <Style x:Key="NumBtnStyle" TargetType="Button">
                        <Setter Property="Background" Value="#38BDF8"/>
                        <Setter Property="Foreground" Value="#0C4A6E"/>
                        <Setter Property="FontSize" Value="28"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Margin" Value="4"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" x:Name="bd">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="4" ShadowDepth="2"/>
                                        </Border.Effect>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>

                <!-- Row 0: 7, 8, 9 -->
                <Button Grid.Row="0" Grid.Column="0" Content="7" Style="{StaticResource NumBtnStyle}" Click="BtnNum_Click"/>
                <Button Grid.Row="0" Grid.Column="1" Content="8" Style="{StaticResource NumBtnStyle}" Click="BtnNum_Click"/>
                <Button Grid.Row="0" Grid.Column="2" Content="9" Style="{StaticResource NumBtnStyle}" Click="BtnNum_Click"/>

                <!-- Row 1: 4, 5, 6 -->
                <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource NumBtnStyle}" Click="BtnNum_Click"/>
                <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource NumBtnStyle}" Click="BtnNum_Click"/>
                <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource NumBtnStyle}" Click="BtnNum_Click"/>

                <!-- Row 2: 1, 2, 3 -->
                <Button Grid.Row="2" Grid.Column="0" Content="1" Style="{StaticResource NumBtnStyle}" Click="BtnNum_Click"/>
                <Button Grid.Row="2" Grid.Column="1" Content="2" Style="{StaticResource NumBtnStyle}" Click="BtnNum_Click"/>
                <Button Grid.Row="2" Grid.Column="2" Content="3" Style="{StaticResource NumBtnStyle}" Click="BtnNum_Click"/>

                <!-- Row 3: İMTİNA, 0, TƏSDİQ ET -->
                <Button Grid.Row="3" Grid.Column="0" Content="İMTİNA" Style="{StaticResource NumBtnStyle}" Background="#EF4444" Foreground="White" FontSize="17" FontWeight="Black" Click="BtnCancel_Click"/>
                <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource NumBtnStyle}" Click="BtnNum_Click"/>
                <Button Grid.Row="3" Grid.Column="2" Content="TƏSDİQ ET" Style="{StaticResource NumBtnStyle}" Background="#10B981" Foreground="White" FontSize="16" FontWeight="Black" Click="BtnConfirm_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
