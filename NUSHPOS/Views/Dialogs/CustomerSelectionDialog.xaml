<Window x:Class="NUSHPOS.Views.Dialogs.CustomerSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Müştəri Seçimi"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="880" Height="580">

    <Border Background="#F8FAFC" BorderBrush="#0284C7" BorderThickness="2" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="16" ShadowDepth="4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>  <!-- Window Title Header -->
                <RowDefinition Height="Auto"/> <!-- Notice Banner -->
                <RowDefinition Height="*"/>    <!-- List of matching addresses -->
                <RowDefinition Height="70"/>   <!-- Bottom Actions -->
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="#0F172A" CornerRadius="10,10,0,0" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="MÜŞTƏRİ VƏ ÜNVAN SEÇİMİ" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" Background="Transparent" Foreground="#F87171" FontWeight="Bold" FontSize="18" BorderThickness="0" Click="BtnCancel_Click" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Indigo/Slate Notice Banner -->
            <Border Grid.Row="1" Background="#4338CA" Margin="12,10,12,6" Padding="16,12" CornerRadius="8">
                <TextBlock x:Name="txtNotice"
                           Text="TELEFON NÖMRƏSİ BİRDƏN ÇOX ÜNVANDA QEYDİYYATDADIR. ZƏHMƏT OLMASA LAZIMI ÜNVANI SEÇİN." 
                           Foreground="#FFFFFF" 
                           FontSize="15" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </Border>

            <!-- Customer List Cards -->
            <ScrollViewer Grid.Row="2" Margin="12,6,12,6" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="icCustomers">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,5" 
                                    MinHeight="80"
                                    BorderBrush="#CBD5E1" 
                                    BorderThickness="1.5" 
                                    Background="#FFFFFF"
                                    Click="BtnCustomerSelect_Click"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="8" 
                                                Padding="16,10"
                                                x:Name="cardBorder">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="6" ShadowDepth="2"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                
                                                <!-- Customer Name / Phone -->
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Border Background="#E0F2FE" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                                        <TextBlock Text="👤 MÜŞTƏRİ" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding CustomerName, FallbackValue='MÜŞTƏRİ ADI'}" 
                                                               FontSize="16" 
                                                               FontWeight="Black" 
                                                               Foreground="#0F172A"/>
                                                </StackPanel>

                                                <!-- Customer Full Address -->
                                                <TextBlock Grid.Row="1" 
                                                           Text="{Binding FullAddressDisplay}" 
                                                           FontSize="13" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="#475569" 
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="cardBorder" Property="Background" Value="#F0F9FF"/>
                                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#0284C7"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="cardBorder" Property="Background" Value="#E0F2FE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Bottom Action -->
            <Border Grid.Row="3" Background="#E2E8F0" CornerRadius="0,0,10,10" Padding="16,10">
                <Button Content="İMTİNA" 
                        Width="140" 
                        Height="46" 
                        HorizontalAlignment="Right" 
                        Background="#EF4444" 
                        Foreground="White" 
                        FontSize="18" 
                        FontWeight="Black" 
                        BorderThickness="0" 
                        Click="BtnCancel_Click"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" x:Name="bd">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
