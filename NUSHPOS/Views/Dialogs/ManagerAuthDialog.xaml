<Window x:Class="NUSHPOS.Views.Dialogs.ManagerAuthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        mc:Ignorable="d" 
        Title="Səlahiyyət Təsdiqi" 
        Height="540" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="White" CornerRadius="10" BorderBrush="#1e2c43" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="65"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="#1e2c43" CornerRadius="8,8,0,0" Padding="15,0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔐 " FontSize="16" Foreground="#f59e0b"/>
                        <TextBlock Text="SƏLAHİYYƏT TƏSDİQİ" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" Width="30" Height="30" Background="Transparent" Foreground="#cbd5e1" BorderThickness="0" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" Command="{Binding CancelCommand}" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- ACTION INFO -->
            <Border Grid.Row="1" Background="#f0f9ff" BorderBrush="#bae6fd" BorderThickness="0,0,0,1" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="{Binding ActionName}" FontWeight="Bold" FontSize="14" Foreground="#0369a1" TextAlignment="Center"/>
                    <TextBlock Text="Bu əməliyyat üçün səlahiyyətli şəxsin şifrəsi tələb olunur." FontSize="11" Foreground="#64748b" TextAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding RequiredLevel, StringFormat='Tələb olunan minimum səviyyə: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#e11d48" TextAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- PIN DISPLAY -->
            <StackPanel Grid.Row="2" Margin="20,12,20,4">
                <Border Height="46" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1.5" CornerRadius="6">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Şifrəni daxil edin..." FontSize="13" Foreground="#94a3b8" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DisplayPin}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding DisplayPin}" FontSize="24" FontWeight="Bold" Foreground="#1e293b" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ERROR MESSAGE -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#e11d48" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" MinHeight="16"/>
            </StackPanel>

            <!-- NUMPAD -->
            <Grid Grid.Row="3" Margin="20,4,20,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.Resources>
                    <Style x:Key="NumBtn" TargetType="Button">
                        <Setter Property="Margin" Value="4"/>
                        <Setter Property="FontSize" Value="20"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Background" Value="#f1f5f9"/>
                        <Setter Property="Foreground" Value="#1e293b"/>
                        <Setter Property="BorderBrush" Value="#cbd5e1"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>

                <!-- Row 0 -->
                <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource NumBtn}" Command="{Binding NumpadCommand}" CommandParameter="1"/>
                <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource NumBtn}" Command="{Binding NumpadCommand}" CommandParameter="2"/>
                <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource NumBtn}" Command="{Binding NumpadCommand}" CommandParameter="3"/>

                <!-- Row 1 -->
                <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource NumBtn}" Command="{Binding NumpadCommand}" CommandParameter="4"/>
                <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource NumBtn}" Command="{Binding NumpadCommand}" CommandParameter="5"/>
                <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource NumBtn}" Command="{Binding NumpadCommand}" CommandParameter="6"/>

                <!-- Row 2 -->
                <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource NumBtn}" Command="{Binding NumpadCommand}" CommandParameter="7"/>
                <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource NumBtn}" Command="{Binding NumpadCommand}" CommandParameter="8"/>
                <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource NumBtn}" Command="{Binding NumpadCommand}" CommandParameter="9"/>

                <!-- Row 3 -->
                <Button Grid.Row="3" Grid.Column="0" Content="C" Style="{StaticResource NumBtn}" Background="#fee2e2" Foreground="#dc2626" Command="{Binding ClearCommand}"/>
                <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource NumBtn}" Command="{Binding NumpadCommand}" CommandParameter="0"/>
                <Button Grid.Row="3" Grid.Column="2" Content="⌫" Style="{StaticResource NumBtn}" Background="#fef3c7" Foreground="#d97706" Command="{Binding BackspaceCommand}"/>
            </Grid>

            <!-- BOTTOM BUTTONS -->
            <Border Grid.Row="4" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="İMTİNA" Command="{Binding CancelCommand}" Height="40" Margin="0,0,6,0" Background="#e11d48" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Grid.Column="1" Content="TƏSDİQ ET" Command="{Binding ConfirmCommand}" Height="40" Margin="6,0,0,0" Background="#16a34a" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
