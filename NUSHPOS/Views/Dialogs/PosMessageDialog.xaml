<Window x:Class="NUSHPOS.Views.Dialogs.PosMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        mc:Ignorable="d"
        Title="Bildiriş"
        Width="620" MinHeight="340" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Focusable="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Modern OK / Action Button Style -->
        <Style x:Key="PosDarkActionButton" TargetType="Button">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="8" BorderThickness="1.5" BorderBrush="#0F172A">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#2D3748" Offset="0"/>
                                    <GradientStop Color="#1A202C" Offset="0.5"/>
                                    <GradientStop Color="#0F172A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="24,12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#4A5568" Offset="0"/>
                                            <GradientStop Color="#2D3748" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" CenterX="100" CenterY="25"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Yes / Success Button Style -->
        <Style x:Key="PosYesActionButton" TargetType="Button">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="8" BorderThickness="1.5" BorderBrush="#047857">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#10B981" Offset="0"/>
                                    <GradientStop Color="#059669" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="24,12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#34D399" Offset="0"/>
                                            <GradientStop Color="#10B981" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#6EE7B7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" CenterX="100" CenterY="25"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- No / Cancel Button Style -->
        <Style x:Key="PosNoActionButton" TargetType="Button">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="8" BorderThickness="1.5" BorderBrush="#475569">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#64748B" Offset="0"/>
                                    <GradientStop Color="#475569" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="24,12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#94A3B8" Offset="0"/>
                                            <GradientStop Color="#64748B" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" CenterX="100" CenterY="25"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Dialog Card Container -->
    <Border Background="#F1F5F9"
            CornerRadius="16"
            BorderBrush="#94A3B8"
            BorderThickness="2"
            Margin="16"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.45" Direction="270"/>
        </Border.Effect>

        <Grid Margin="0,0,0,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0: Header -->
                <RowDefinition Height="Auto"/>  <!-- 1: Divider -->
                <RowDefinition Height="*"/>     <!-- 2: Message Body -->
                <RowDefinition Height="Auto"/>  <!-- 3: Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 0: Header Area -->
            <Grid Grid.Row="0" Margin="24,18,24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Container -->
                <Border Grid.Column="0" 
                        x:Name="IconBorder"
                        Width="46" Height="46" 
                        CornerRadius="23"
                        Background="#EF4444"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtIconSymbol"
                               Text="!"
                               FontSize="30"
                               FontWeight="Black"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-2,0,0"/>
                </Border>

                <!-- Header Title -->
                <TextBlock Grid.Column="1"
                           x:Name="TxtTitle"
                           Text="XƏBƏRDARLIQ BİLDİRİŞİ"
                           FontSize="24"
                           FontWeight="Black"
                           Foreground="#0F172A"
                           VerticalAlignment="Center"/>

                <!-- Live Countdown Number -->
                <Border Grid.Column="2" 
                        x:Name="CountdownBadge"
                        CornerRadius="8"
                        Background="#FEE2E2"
                        BorderBrush="#FECACA"
                        BorderThickness="1"
                        Padding="10,4"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCountdown"
                               Text="20"
                               FontSize="22"
                               FontWeight="Black"
                               Foreground="#DC2626"/>
                </Border>
            </Grid>

            <!-- 1: Divider Line -->
            <Border Grid.Row="1" Height="2" Background="#94A3B8" Margin="24,0,24,0" SnapsToDevicePixels="True"/>

            <!-- 2: Main Message Text Area -->
            <StackPanel Grid.Row="2" Margin="30,28,30,28" VerticalAlignment="Center">
                <TextBlock x:Name="TxtMessage"
                           Text="SİSTEM TƏNZİMLƏMƏLƏRİNİZƏ ƏSASƏN AÇIQ ÇEK VARKƏN KASSİR ÇIXIŞINA İCAZƏ VERİLMİR"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="32"/>

                <!-- Optional secondary / details text -->
                <TextBlock x:Name="TxtDetails"
                           Text=""
                           FontSize="15"
                           FontWeight="Medium"
                           Foreground="#475569"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- 3: Action Buttons Area -->
            <Grid Grid.Row="3" Margin="24,0,24,0">
                <!-- Single OK Button Panel -->
                <StackPanel x:Name="PanelOk" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnOk"
                            Content="TAMAM"
                            Style="{StaticResource PosDarkActionButton}"
                            MinWidth="240" Height="58"
                            Click="BtnOk_Click"/>
                </StackPanel>

                <!-- Yes / No Buttons Panel -->
                <Grid x:Name="PanelYesNo" Visibility="Collapsed" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            x:Name="BtnYes"
                            Content="BƏLİ"
                            Style="{StaticResource PosYesActionButton}"
                            MinWidth="180" Height="58"
                            Click="BtnYes_Click"/>

                    <Button Grid.Column="2"
                            x:Name="BtnNo"
                            Content="XEYR"
                            Style="{StaticResource PosNoActionButton}"
                            MinWidth="180" Height="58"
                            Click="BtnNo_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
