<Window x:Class="NUSHPOS.Views.Dialogs.ChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Para Üstü" Height="600" Width="800" 
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" 
        ResizeMode="NoResize"
        Background="#E6F2FF">
    
    <Border BorderBrush="#8BB5DA" BorderThickness="3">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0">
                <TextBlock Text="PARA ÜSTÜ" FontSize="28" FontWeight="Bold" Foreground="#33597D" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Countdown}" FontSize="28" FontWeight="Bold" Foreground="Red" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            
            <TextBlock Grid.Row="1" Text="{Binding ChangeAmountString}" FontSize="250" FontWeight="Bold" Foreground="#4A5C6A" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-40,0,0"/>
            
            <UniformGrid Grid.Row="2" Columns="6" Height="80" Margin="0,20,0,0">
                <UniformGrid.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="2"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#619EE2"/>

                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </UniformGrid.Resources>
                
                <Button>
                    <TextBlock Text="SÜREKLİ MÜŞTERİ TAKİBİ" TextWrapping="Wrap" TextAlignment="Center"/>
                </Button>
                <Button Content="HESAP YAZDIR"/>
                <Button Content="ADİSYON YAZDIR"/>
                <Button Content="FATURA YAZDIR"/>
                <Button>
                    <TextBlock Text="YAZAR KASA FİŞİ YAZDIR" TextWrapping="Wrap" TextAlignment="Center"/>
                </Button>
                <Button Content="TAMAM" Command="{Binding CloseDialogCommand}" Background="#4CAF50" FontSize="24" FontWeight="Bold"/>
            </UniformGrid>
        </Grid>
    </Border>
</Window>
