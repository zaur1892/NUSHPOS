<Window x:Class="NUSHPOS.Views.Dialogs.CashierOutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:converters="clr-namespace:NUSHPOS.Converters"
        xmlns:vm="clr-namespace:NUSHPOS.ViewModels"
        mc:Ignorable="d" 
        Title="Kassir Çıxış Forması" 
        Height="760" Width="1120"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="True"
        Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:EqualityConverter x:Key="EqConverter"/>

        <!-- Gradient Styles -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1E1B4B" Offset="0"/>
            <GradientStop Color="#312E81" Offset="0.5"/>
            <GradientStop Color="#4338CA" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardHeaderCash" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#065F46" Offset="0"/>
            <GradientStop Color="#059669" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardHeaderCard" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1E40AF" Offset="0"/>
            <GradientStop Color="#2563EB" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardHeaderOther" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7C2D12" Offset="0"/>
            <GradientStop Color="#EA580C" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardHeaderExpense" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#831843" Offset="0"/>
            <GradientStop Color="#BE185D" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="NumpadTouchBtn" TargetType="Button">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyboardKeyBtn" TargetType="Button">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DiscrepancyReasonTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="CaretBrush" Value="#0F172A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F8FAFC" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="2" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.4"/>
        </Border.Effect>

        <Grid>
            <!-- 1. MAIN CASHIER OUT SCREEN (When CurrentStep == MainForm) -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="65"/>  <!-- Header -->
                    <RowDefinition Height="50"/>  <!-- Info Strip -->
                    <RowDefinition Height="*"/>   <!-- 4 Columns of Payments -->
                    <RowDefinition Height="90"/>  <!-- Footer Controls & Totals -->
                </Grid.RowDefinitions>

                <!-- 1.1 HEADER -->
                <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" Padding="20,0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NUSHPOS KASSİR ÇIXIŞ FORMASI" FontSize="20" FontWeight="Black" Foreground="White"/>
                            <TextBlock Text="Kassa Sessiyasının Yekunlaşdırılması və Z-Balans Hesabatı" FontSize="11" Foreground="#A5B4FC" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="✕" Width="36" Height="36" Background="#30FFFFFF" Foreground="White" BorderThickness="0" FontSize="16" FontWeight="Bold" Command="{Binding CancelCommand}" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="18"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 1.2 INFO STRIP -->
                <Border Grid.Row="1" Background="#EEF2FF" BorderBrush="#E0E7FF" BorderThickness="0,0,0,1" Padding="20,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🕒 Kassa Açılışı: " FontSize="12" FontWeight="Bold" Foreground="#475569"/>
                            <TextBlock Text="{Binding SignInTime}" FontSize="12" FontWeight="Bold" Foreground="#1E1B4B"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤 Kassir: " FontSize="12" FontWeight="Bold" Foreground="#475569"/>
                            <TextBlock Text="{Binding EmployeeName}" FontSize="12" FontWeight="Bold" Foreground="#1E1B4B"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💻 Terminal: " FontSize="12" FontWeight="Bold" Foreground="#475569"/>
                            <TextBlock Text="{Binding StationName}" FontSize="12" FontWeight="Bold" Foreground="#1E1B4B"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="💰 Açılış Məbləği: " FontSize="12" FontWeight="Bold" Foreground="#475569"/>
                            <TextBlock Text="{Binding StartAmount, StringFormat='\{0:N2\} ₼'}" FontSize="13" FontWeight="Black" Foreground="#059669"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 1.3 4 COLUMNS OF PAYMENTS -->
                <Grid Grid.Row="2" Margin="15,10,15,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CARD 1: NAĞD PUL (Nakit) -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Margin="5" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="45"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource CardHeaderCash}" Padding="10,0">
                                <TextBlock Text="💵 NAĞD PUL (NAKİT)" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="5">
                                <ItemsControl ItemsSource="{Binding CashPayments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,6" Padding="8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="{Binding PaymentMethodName}" FontSize="12" FontWeight="Bold" Foreground="#334155"/>
                                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0" Height="36" Background="#ECFDF5" BorderBrush="#6EE7B7" BorderThickness="1" Cursor="Hand"
                                                                Command="{Binding DataContext.SelectPaymentForEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="{Binding CountedAmount, StringFormat='\{0:N2\} ₼'}" FontSize="15" FontWeight="Black" Foreground="#047857" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                                        </Button>
                                                        <TextBlock Grid.Column="1" Text="{Binding AmountPaid, StringFormat='Sistem: \{0:N2\}'}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,0,0"
                                                                   Visibility="{Binding DataContext.ShowSystemAmounts, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="10,0">
                                <Grid VerticalAlignment="Center">
                                    <TextBlock Text="Nağd Cəmi:" FontSize="12" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalCashCounted, StringFormat='\{0:N2\} ₼'}" FontSize="14" FontWeight="Black" Foreground="#059669" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- CARD 2: BANK KARTLARI (POS) -->
                    <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Margin="5" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="45"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource CardHeaderCard}" Padding="10,0">
                                <TextBlock Text="💳 BANK KARTLARI (POS)" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="5">
                                <ItemsControl ItemsSource="{Binding CardPayments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,6" Padding="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PaymentMethodName}" FontSize="11" FontWeight="Bold" Foreground="#1E293B"/>
                                                        <TextBlock Text="{Binding AmountPaid, StringFormat='Sistem: \{0:N2\} ₼'}" FontSize="10" Foreground="#64748B"
                                                                   Visibility="{Binding DataContext.ShowSystemAmounts, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="1" Height="34" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" Cursor="Hand"
                                                            Command="{Binding DataContext.SelectPaymentForEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding CountedAmount, StringFormat='\{0:N2\}'}" FontSize="13" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="10,0">
                                <Grid VerticalAlignment="Center">
                                    <TextBlock Text="Kart Cəmi:" FontSize="12" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalCardCounted, StringFormat='\{0:N2\} ₼'}" FontSize="14" FontWeight="Black" Foreground="#2563EB" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- CARD 3: ÇATDIRILMA / YEMƏK ÇEKLƏRİ -->
                    <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Margin="5" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="45"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource CardHeaderOther}" Padding="10,0">
                                <TextBlock Text="🛵 ÇATDIRILMA &amp; ÇEKLƏR" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="5">
                                <ItemsControl ItemsSource="{Binding OtherPayments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,6" Padding="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PaymentMethodName}" FontSize="11" FontWeight="Bold" Foreground="#1E293B"/>
                                                        <TextBlock Text="{Binding AmountPaid, StringFormat='Sistem: \{0:N2\} ₼'}" FontSize="10" Foreground="#64748B"
                                                                   Visibility="{Binding DataContext.ShowSystemAmounts, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="1" Height="34" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" Cursor="Hand"
                                                            Command="{Binding DataContext.SelectPaymentForEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding CountedAmount, StringFormat='\{0:N2\}'}" FontSize="13" FontWeight="Bold" Foreground="#C2410C" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="10,0">
                                <Grid VerticalAlignment="Center">
                                    <TextBlock Text="Digər Cəm:" FontSize="12" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalOtherCounted, StringFormat='\{0:N2\} ₼'}" FontSize="14" FontWeight="Black" Foreground="#EA580C" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- CARD 4: XƏRCLƏR (MASRAFLAR) -->
                    <Border Grid.Column="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Margin="5" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="45"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource CardHeaderExpense}" Padding="10,0">
                                <TextBlock Text="📉 XƏRCLƏR (MƏXARİC)" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="5">
                                <ItemsControl ItemsSource="{Binding Expenses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FDF2F8" BorderBrush="#FBCFE8" BorderThickness="1" CornerRadius="6" Margin="0,0,0,5" Padding="6">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ExpenseName}" FontSize="11" FontWeight="Bold" Foreground="#9D174D"/>
                                                        <TextBlock Text="{Binding ExpenseDescription}" FontSize="10" Foreground="#64748B"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ExpenseAmount, StringFormat='\{0:N2\} ₼'}" FontSize="12" FontWeight="Bold" Foreground="#BE185D" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="10,0">
                                <Grid VerticalAlignment="Center">
                                    <TextBlock Text="Toplam Xərc:" FontSize="12" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalExpenses, StringFormat='\{0:N2\} ₼'}" FontSize="14" FontWeight="Black" Foreground="#BE185D" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 1.4 FOOTER WITH TOTALS & ACTION BUTTONS -->
                <Border Grid.Row="3" Background="White" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Show system amounts toggle -->
                            <ColumnDefinition Width="*"/>    <!-- Totals & Discrepancy Card -->
                            <ColumnDefinition Width="Auto"/> <!-- Action Buttons -->
                        </Grid.ColumnDefinitions>

                        <!-- Toggle Button -->
                        <Button Grid.Column="0" Command="{Binding ToggleShowSystemAmountsCommand}" Height="46" Padding="15,0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#334155" FontWeight="Bold" FontSize="12" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👁️ " FontSize="14"/>
                                <TextBlock Text="SİSTEM MƏBLƏĞLƏRİ"/>
                            </StackPanel>
                        </Button>

                        <!-- Totals Summary Card -->
                        <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="20,0" Padding="15,5" VerticalAlignment="Center">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="DAXİL EDİLƏN CƏM" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding GrandTotalCounted, StringFormat='\{0:N2\} ₼'}" FontSize="18" FontWeight="Black" Foreground="#0F172A"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="SİSTEM CƏMİ" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding GrandTotalExpected, StringFormat='\{0:N2\} ₼'}" FontSize="18" FontWeight="Black" Foreground="#4F46E5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="KASSA FƏRQİ" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding DiscrepancyStatusText}" FontSize="18" FontWeight="Black" Foreground="#EF4444"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="LƏĞV ET" Command="{Binding CancelCommand}" Width="110" Height="50" Margin="0,0,10,0" Background="#EF4444" Foreground="White" FontWeight="Black" FontSize="14" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="TƏSDİQ ET" Command="{Binding SubmitFormCommand}" Width="130" Height="50" Background="#10B981" Foreground="White" FontWeight="Black" FontSize="15" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. POPUP: TOUCH NUMPAD FOR EDITING SELECTED ITEM AMOUNT -->
            <Grid Background="#7F0F172A" Visibility="{Binding IsNumpadOpen, Converter={StaticResource BoolToVis}}">
                <Border Width="340" Height="420" Background="White" CornerRadius="16" BorderBrush="#CBD5E1" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding SelectedPaymentItem.PaymentMethodName, StringFormat='Məbləğ: \{0\}'}" FontSize="14" FontWeight="Bold" Foreground="#1E293B" TextAlignment="Center" Margin="0,0,0,5"/>

                        <!-- Display -->
                        <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="10,0">
                            <TextBlock Text="{Binding NumpadDisplay}" FontSize="32" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Keypad -->
                        <Grid Grid.Row="2" Margin="0,10,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Content="7" Style="{StaticResource NumpadTouchBtn}" Command="{Binding NumpadPressCommand}" CommandParameter="7"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="8" Style="{StaticResource NumpadTouchBtn}" Command="{Binding NumpadPressCommand}" CommandParameter="8"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="9" Style="{StaticResource NumpadTouchBtn}" Command="{Binding NumpadPressCommand}" CommandParameter="9"/>

                            <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource NumpadTouchBtn}" Command="{Binding NumpadPressCommand}" CommandParameter="4"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource NumpadTouchBtn}" Command="{Binding NumpadPressCommand}" CommandParameter="5"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource NumpadTouchBtn}" Command="{Binding NumpadPressCommand}" CommandParameter="6"/>

                            <Button Grid.Row="2" Grid.Column="0" Content="1" Style="{StaticResource NumpadTouchBtn}" Command="{Binding NumpadPressCommand}" CommandParameter="1"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="2" Style="{StaticResource NumpadTouchBtn}" Command="{Binding NumpadPressCommand}" CommandParameter="2"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="3" Style="{StaticResource NumpadTouchBtn}" Command="{Binding NumpadPressCommand}" CommandParameter="3"/>

                            <Button Grid.Row="3" Grid.Column="0" Content="." Style="{StaticResource NumpadTouchBtn}" Command="{Binding NumpadPressCommand}" CommandParameter="."/>
                            <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource NumpadTouchBtn}" Command="{Binding NumpadPressCommand}" CommandParameter="0"/>
                            <Button Grid.Row="3" Grid.Column="2" Content="⌫" Style="{StaticResource NumpadTouchBtn}" Background="#FEF3C7" Foreground="#D97706" Command="{Binding NumpadBackspaceCommand}"/>
                        </Grid>

                                        <Button Grid.Row="3" Content="DAXİL ET" Command="{Binding CloseNumpadCommand}" Background="#10B981" Foreground="White" FontWeight="Black" FontSize="15" BorderThickness="0" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>

            <!-- 3. OVERLAY: AÇIQ SİFARİŞLƏR XƏBƏRDARLIĞI (OpenOrdersWarning) -->
            <Grid Background="#B20F172A" Visibility="{Binding CurrentStep, Converter={StaticResource EqConverter}, ConverterParameter={x:Static vm:CashierOutStep.OpenOrdersWarning}}">
                <Border Width="580" MinHeight="320" Background="#F1F5F9" CornerRadius="16" BorderBrush="#94A3B8" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid Margin="0,0,0,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="24,18,24,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#EF4444" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="!" FontSize="28" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                            </Border>

                            <TextBlock Grid.Column="1" Text="XƏBƏRDARLIQ BİLDİRİŞİ" FontSize="22" FontWeight="Black" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Grid.Row="1" Height="2" Background="#94A3B8" Margin="24,0,24,0" SnapsToDevicePixels="True"/>

                        <StackPanel Grid.Row="2" Margin="30,24,30,24" VerticalAlignment="Center">
                            <TextBlock Text="SİSTEM TƏNZİMLƏMƏLƏRİNİZƏ ƏSASƏN AÇIQ ÇEK VARKƏN KASSİR ÇIXIŞINA İCAZƏ VERİLMİR" FontSize="19" FontWeight="Bold" Foreground="#0F172A" TextAlignment="Center" TextWrapping="Wrap" LineHeight="28"/>
                            <TextBlock Text="{Binding OpenOrdersCount, StringFormat='Sistemdə hələ də \{0\} ədəd ödənilməmiş açıq sifariş (masa) mövcuddur. Kassadan çıxış etmək üçün əvvəlcə bütün açıq sifarişləri bağlayın.'}" FontSize="14" Foreground="#64748B" TextAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Row="3" Content="TAMAM" Command="{Binding CancelCommand}" MinWidth="220" Height="56" HorizontalAlignment="Center" Foreground="White" FontWeight="Black" FontSize="18" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="8" BorderThickness="1.5" BorderBrush="#0F172A">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#2D3748" Offset="0"/>
                                                <GradientStop Color="#1A202C" Offset="0.5"/>
                                                <GradientStop Color="#0F172A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- 4. OVERLAY: TƏSDİQ BİLDİRİŞİ ("Pulu saydınızmı?") -->
            <Grid Background="#B20F172A" Visibility="{Binding CurrentStep, Converter={StaticResource EqConverter}, ConverterParameter={x:Static vm:CashierOutStep.ConfirmPrompt}}">
                <Border Width="480" MinHeight="310" Background="#F1F5F9" CornerRadius="16" BorderBrush="#94A3B8" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid Margin="0,0,0,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header with countdown -->
                        <Grid Grid.Row="0" Margin="24,18,24,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#F59E0B" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="?" FontSize="26" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                            </Border>

                            <TextBlock Grid.Column="1" Text="TƏSDİQ BİLDİRİŞİ" FontSize="22" FontWeight="Black" Foreground="#0F172A" VerticalAlignment="Center"/>

                            <Border Grid.Column="2" CornerRadius="8" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" Padding="10,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ConfirmCountdown}" FontSize="22" FontWeight="Black" Foreground="#DC2626"/>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1" Height="2" Background="#94A3B8" Margin="24,0,24,0" SnapsToDevicePixels="True"/>

                        <!-- Question -->
                        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,24,24,24">
                            <TextBlock Text="Pulu saydınızmı?" FontSize="24" FontWeight="Black" Foreground="#0F172A" TextAlignment="Center" Margin="0,0,0,10"/>
                            <Border Background="#E0E7FF" CornerRadius="8" Padding="14,6" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding GrandTotalCounted, StringFormat='Toplam Sayılan: \{0:N2\} ₼'}" FontSize="17" FontWeight="Bold" Foreground="#3730A3" TextAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Buttons -->
                        <Grid Grid.Row="3" Margin="24,0,24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="BƏLİ" Command="{Binding ConfirmYesCommand}" Height="56" Foreground="White" FontWeight="Black" FontSize="19" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8" BorderThickness="1.5" BorderBrush="#047857">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#10B981" Offset="0"/>
                                                    <GradientStop Color="#059669" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="2" Content="XEYR" Command="{Binding ConfirmNoCommand}" Height="56" Foreground="White" FontWeight="Black" FontSize="19" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8" BorderThickness="1.5" BorderBrush="#475569">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#64748B" Offset="0"/>
                                                    <GradientStop Color="#475569" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 5. OVERLAY: KASSA FƏRQİ AÇIQLAMASI (DiscrepancyReason with Virtual Touch Keyboard) -->
            <Grid Background="#B20F172A" Visibility="{Binding CurrentStep, Converter={StaticResource EqConverter}, ConverterParameter={x:Static vm:CashierOutStep.DiscrepancyReason}}">
                <Border Width="850" Height="620" Background="White" CornerRadius="16" BorderBrush="#CBD5E1" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="80"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="70"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="#4F46E5" CornerRadius="14,14,0,0" Padding="20,0">
                            <TextBlock Text="KASSA FƏRQİ ÜÇÜN AÇIQLAMA DAXİL EDİN" FontSize="17" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Presets -->
                        <WrapPanel Grid.Row="1" Margin="20,10,20,6">
                            <Button Content="FƏRQDƏN MÜDİRİN XƏBƏRİ VAR!" Height="36" Margin="0,0,8,6" Padding="14,0" Background="#EEF2FF" Foreground="#4338CA" FontWeight="Bold" FontSize="12" BorderThickness="1" BorderBrush="#C7D2FE" Cursor="Hand" Command="{Binding SelectPresetReasonCommand}" CommandParameter="FƏRQDƏN MÜDİRİN XƏBƏRİ VAR!"/>
                            <Button Content="Qalıq pul yuvarlaqlaşdırması" Height="36" Margin="0,0,8,6" Padding="14,0" Background="#EEF2FF" Foreground="#4338CA" FontWeight="Bold" FontSize="12" BorderThickness="1" BorderBrush="#C7D2FE" Cursor="Hand" Command="{Binding SelectPresetReasonCommand}" CommandParameter="Qalıq pul yuvarlaqlaşdırması"/>
                            <Button Content="Kassir çatışmayan fərqi ödəyəcək" Height="36" Margin="0,0,8,6" Padding="14,0" Background="#EEF2FF" Foreground="#4338CA" FontWeight="Bold" FontSize="12" BorderThickness="1" BorderBrush="#C7D2FE" Cursor="Hand" Command="{Binding SelectPresetReasonCommand}" CommandParameter="Kassir çatışmayan fərqi ödəyəcək"/>
                        </WrapPanel>

                        <!-- Text Display Area -->
                        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="10" Margin="20,0,20,10" Padding="4">
                            <TextBox Text="{Binding DiscrepancyReasonText, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource DiscrepancyReasonTextBoxStyle}"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Stretch"/>
                        </Border>

                        <!-- Virtual Touch Keyboard (Azerbaijani layout) -->
                        <Grid Grid.Row="3" Margin="20,0,20,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Row 1: Q W E R T Y U I O P Ö Ü Ğ -->
                            <UniformGrid Grid.Row="0" Columns="13">
                                <Button Content="Q" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="Q"/>
                                <Button Content="Ü" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="Ü"/>
                                <Button Content="E" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="E"/>
                                <Button Content="R" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="R"/>
                                <Button Content="T" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="T"/>
                                <Button Content="Y" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="Y"/>
                                <Button Content="U" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="U"/>
                                <Button Content="İ" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="İ"/>
                                <Button Content="O" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="O"/>
                                <Button Content="P" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="P"/>
                                <Button Content="Ö" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="Ö"/>
                                <Button Content="Ğ" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="Ğ"/>
                                <Button Content="I" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="I"/>
                            </UniformGrid>

                            <!-- Row 2: A S D F G H J K L Ə Ş -->
                            <UniformGrid Grid.Row="1" Columns="12">
                                <Button Content="A" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="A"/>
                                <Button Content="S" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="S"/>
                                <Button Content="D" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="D"/>
                                <Button Content="F" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="F"/>
                                <Button Content="G" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="G"/>
                                <Button Content="H" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="H"/>
                                <Button Content="J" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="J"/>
                                <Button Content="K" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="K"/>
                                <Button Content="L" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="L"/>
                                <Button Content="Ə" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="Ə"/>
                                <Button Content="Ş" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="Ş"/>
                                <Button Content="!" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="!"/>
                            </UniformGrid>

                            <!-- Row 3: Z X C V B N M Ç , . -->
                            <UniformGrid Grid.Row="2" Columns="12">
                                <Button Content="Z" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="Z"/>
                                <Button Content="X" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="X"/>
                                <Button Content="C" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="C"/>
                                <Button Content="Ç" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="Ç"/>
                                <Button Content="V" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="V"/>
                                <Button Content="B" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="B"/>
                                <Button Content="N" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="N"/>
                                <Button Content="M" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="M"/>
                                <Button Content="," Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter=","/>
                                <Button Content="." Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="."/>
                                <Button Content=":" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter=":"/>
                                <Button Content="-" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="-"/>
                            </UniformGrid>

                            <!-- Row 4: SPACE, CLEAR, BACKSPACE -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="TƏMİZLƏ" Style="{StaticResource KeyboardKeyBtn}" Background="#FEE2E2" Foreground="#DC2626" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="CLEAR"/>
                                <Button Grid.Column="1" Content="SPACE (BOŞLUQ)" Style="{StaticResource KeyboardKeyBtn}" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="SPACE"/>
                                <Button Grid.Column="2" Content="⌫ SİL" Style="{StaticResource KeyboardKeyBtn}" Background="#FEF3C7" Foreground="#D97706" Command="{Binding AppendKeyToReasonCommand}" CommandParameter="BACKSPACE"/>
                            </Grid>
                        </Grid>

                        <!-- Footer Actions -->
                        <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14" Padding="20,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="LƏĞV ET" Command="{Binding CancelCommand}" Height="48" Margin="0,0,10,0" Background="#EF4444" Foreground="White" FontWeight="Black" FontSize="15" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="10"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <Button Grid.Column="1" Content="SESSİYANI BAĞLA" Command="{Binding SubmitDiscrepancyReasonCommand}" Height="48" Margin="10,0,0,0" Background="#10B981" Foreground="White" FontWeight="Black" FontSize="15" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="10"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 6. OVERLAY: UĞURLU BAĞLANIŞ BİLDİRİŞİ (SuccessInfo) -->
            <Grid Background="#B20F172A" Visibility="{Binding CurrentStep, Converter={StaticResource EqConverter}, ConverterParameter={x:Static vm:CashierOutStep.SuccessInfo}}">
                <Border Width="540" MinHeight="310" Background="#F1F5F9" CornerRadius="16" BorderBrush="#94A3B8" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid Margin="0,0,0,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header with countdown -->
                        <Grid Grid.Row="0" Margin="24,18,24,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#10B981" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="✓" FontSize="26" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                            </Border>

                            <TextBlock Grid.Column="1" Text="MƏLUMAT BİLDİRİŞİ" FontSize="22" FontWeight="Black" Foreground="#0F172A" VerticalAlignment="Center"/>

                            <Border Grid.Column="2" CornerRadius="8" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" Padding="10,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SuccessCountdown}" FontSize="22" FontWeight="Black" Foreground="#DC2626"/>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1" Height="2" Background="#94A3B8" Margin="24,0,24,0" SnapsToDevicePixels="True"/>

                        <!-- Message -->
                        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,24,24,24">
                            <TextBlock Text="KASSİR ÇIXIŞ ƏMƏLİYYATI UĞURLA TAMAMLANDI" FontSize="20" FontWeight="Black" Foreground="#0F172A" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="Kassa hesabatı qeydə alındı və sessiya bağlandı." FontSize="15" FontWeight="Medium" Foreground="#475569" TextAlignment="Center"/>
                        </StackPanel>

                        <!-- Button -->
                        <Button Grid.Row="3" Content="TAMAM" Command="{Binding FinishAndCloseCommand}" MinWidth="220" Height="56" HorizontalAlignment="Center" Foreground="White" FontWeight="Black" FontSize="18" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="8" BorderThickness="1.5" BorderBrush="#0F172A">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#2D3748" Offset="0"/>
                                                <GradientStop Color="#1A202C" Offset="0.5"/>
                                                <GradientStop Color="#0F172A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
