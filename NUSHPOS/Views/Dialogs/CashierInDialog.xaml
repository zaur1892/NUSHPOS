<Window x:Class="NUSHPOS.Views.Dialogs.CashierInDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        mc:Ignorable="d" 
        Title="Kassir Girişi" 
        Height="720" Width="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Numpad Button Style -->
        <Style x:Key="TouchNumpadButton" TargetType="Button">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#CBD5E1"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" CenterX="50" CenterY="30"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Preset Button Style -->
        <Style x:Key="PresetChipButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0284C7"/>
            <Setter Property="Background" Value="#E0F2FE"/>
            <Setter Property="BorderBrush" Value="#BAE6FD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chipBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="#BAE6FD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="#7DD3FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="16" BorderBrush="#334155" BorderThickness="2" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <!-- MAIN INPUT CONTENT -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="65"/>  <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Subtitle / Instructions -->
                    <RowDefinition Height="Auto"/> <!-- Amount LCD Display -->
                    <RowDefinition Height="Auto"/> <!-- Preset Chips -->
                    <RowDefinition Height="*"/>    <!-- Touch Numpad -->
                    <RowDefinition Height="80"/>   <!-- Bottom Actions -->
                </Grid.RowDefinitions>

                <!-- 1. HEADER -->
                <Border Grid.Row="0" Background="#4F46E5" Padding="20,0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NUSHPOS KASSİR GİRİŞİ" FontSize="20" FontWeight="Black" Foreground="White"/>
                            <TextBlock Text="Terminal Sessiyasının Başladılması" FontSize="11" Foreground="#C7D2FE" Margin="0,2,0,0"/>
                        </StackPanel>
                        
                        <Button Content="✕" Width="34" Height="34" Background="#30FFFFFF" Foreground="White" BorderThickness="0" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" Command="{Binding CancelCommand}" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="17"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. SUBTITLE PROMPT -->
                <Border Grid.Row="1" Background="#EEF2FF" BorderBrush="#E0E7FF" BorderThickness="0,0,0,1" Padding="15,12">
                    <TextBlock Text="KASSA AÇILIŞ MƏBLƏĞİNİ DAXİL EDİN" FontSize="15" FontWeight="Bold" Foreground="#3730A3" TextAlignment="Center"/>
                </Border>

                <!-- 3. LCD AMOUNT DISPLAY -->
                <Border Grid.Row="2" Background="#1E293B" CornerRadius="12" Height="85" Margin="20,15,20,10" Padding="20,5">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" Opacity="0.25"/>
                    </Border.Effect>
                    <Grid VerticalAlignment="Center">
                        <TextBlock Text="AÇILIŞ MƏBLƏĞİ" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding DisplayAmount}" FontSize="42" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 4. QUICK PRESETS -->
                <UniformGrid Grid.Row="3" Columns="5" Margin="20,0,20,10">
                    <Button Content="+10 ₼" Style="{StaticResource PresetChipButton}" Command="{Binding AddPresetCommand}" CommandParameter="10"/>
                    <Button Content="+20 ₼" Style="{StaticResource PresetChipButton}" Command="{Binding AddPresetCommand}" CommandParameter="20"/>
                    <Button Content="+50 ₼" Style="{StaticResource PresetChipButton}" Command="{Binding AddPresetCommand}" CommandParameter="50"/>
                    <Button Content="+100 ₼" Style="{StaticResource PresetChipButton}" Command="{Binding AddPresetCommand}" CommandParameter="100"/>
                    <Button Content="SIFIRLA" Style="{StaticResource PresetChipButton}" Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECACA" Command="{Binding ClearCommand}"/>
                </UniformGrid>

                <!-- 5. TOUCH NUMPAD -->
                <Grid Grid.Row="4" Margin="20,0,20,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: 7, 8, 9 -->
                    <Button Grid.Row="0" Grid.Column="0" Content="7" Style="{StaticResource TouchNumpadButton}" Command="{Binding NumpadCommand}" CommandParameter="7"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="8" Style="{StaticResource TouchNumpadButton}" Command="{Binding NumpadCommand}" CommandParameter="8"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="9" Style="{StaticResource TouchNumpadButton}" Command="{Binding NumpadCommand}" CommandParameter="9"/>

                    <!-- Row 1: 4, 5, 6 -->
                    <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource TouchNumpadButton}" Command="{Binding NumpadCommand}" CommandParameter="4"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource TouchNumpadButton}" Command="{Binding NumpadCommand}" CommandParameter="5"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource TouchNumpadButton}" Command="{Binding NumpadCommand}" CommandParameter="6"/>

                    <!-- Row 2: 1, 2, 3 -->
                    <Button Grid.Row="2" Grid.Column="0" Content="1" Style="{StaticResource TouchNumpadButton}" Command="{Binding NumpadCommand}" CommandParameter="1"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="2" Style="{StaticResource TouchNumpadButton}" Command="{Binding NumpadCommand}" CommandParameter="2"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="3" Style="{StaticResource TouchNumpadButton}" Command="{Binding NumpadCommand}" CommandParameter="3"/>

                    <!-- Row 3: ., 0, < -->
                    <Button Grid.Row="3" Grid.Column="0" Content="." Style="{StaticResource TouchNumpadButton}" Command="{Binding NumpadCommand}" CommandParameter="."/>
                    <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource TouchNumpadButton}" Command="{Binding NumpadCommand}" CommandParameter="0"/>
                    <Button Grid.Row="3" Grid.Column="2" Content="⌫" Style="{StaticResource TouchNumpadButton}" Foreground="#D97706" Background="#FEF3C7" BorderBrush="#FDE68A" Command="{Binding BackspaceCommand}"/>
                </Grid>

                <!-- 6. BOTTOM ACTION BUTTONS -->
                <Border Grid.Row="5" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LƏĞV ET (İPTAL) -->
                        <Button Grid.Column="0" Content="LƏĞV ET" Command="{Binding CancelCommand}" Height="54" Margin="0,0,8,0" Background="#EF4444" Foreground="White" FontWeight="Black" FontSize="16" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="12"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- TƏSDİQ ET (TAMAM) -->
                        <Button Grid.Column="1" Content="TƏSDİQ ET" Command="{Binding SubmitAmountCommand}" Height="54" Margin="8,0,0,0" Background="#10B981" Foreground="White" FontWeight="Black" FontSize="16" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="12"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- CONFIRMATION MODAL OVERLAY (Pul sayımını bitirdinizmi?) -->
            <Grid Background="#B20F172A" Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVis}}">
                <Border Width="440" MinHeight="290" Background="#F1F5F9" CornerRadius="16" BorderBrush="#94A3B8" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.5"/>
                    </Border.Effect>

                    <Grid Margin="0,0,0,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- CONFIRMATION HEADER WITH COUNTDOWN -->
                        <Grid Grid.Row="0" Margin="20,16,20,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#F59E0B" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="?" FontSize="26" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                            </Border>

                            <TextBlock Grid.Column="1" Text="TƏSDİQ BİLDİRİŞİ" FontSize="20" FontWeight="Black" Foreground="#0F172A" VerticalAlignment="Center"/>

                            <!-- Countdown Timer in Red -->
                            <Border Grid.Column="2" CornerRadius="8" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" Padding="10,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Countdown}" FontSize="20" FontWeight="Black" Foreground="#DC2626"/>
                            </Border>
                        </Grid>

                        <!-- Divider -->
                        <Border Grid.Row="1" Height="2" Background="#94A3B8" Margin="20,0,20,0" SnapsToDevicePixels="True"/>

                        <!-- CONFIRMATION QUESTION -->
                        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,22,24,22">
                            <TextBlock Text="Pulu saydınızmı?" FontSize="24" FontWeight="Black" Foreground="#0F172A" TextAlignment="Center" Margin="0,0,0,10"/>
                            <Border Background="#E0E7FF" CornerRadius="8" Padding="14,6" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DisplayAmount, StringFormat='Açılış Məbləği: {0}'}" FontSize="16" FontWeight="Bold" Foreground="#3730A3" TextAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- CONFIRMATION ACTION BUTTONS: BƏLİ / XEYR -->
                        <Grid Grid.Row="3" Margin="20,0,20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- BƏLİ (EVET) -->
                            <Button Grid.Column="0" Content="BƏLİ" Command="{Binding ConfirmYesCommand}" Height="54" Foreground="White" FontWeight="Black" FontSize="18" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8" BorderThickness="1.5" BorderBrush="#047857">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#10B981" Offset="0"/>
                                                    <GradientStop Color="#059669" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- XEYR (HAYIR) -->
                            <Button Grid.Column="2" Content="XEYR" Command="{Binding ConfirmNoCommand}" Height="54" Foreground="White" FontWeight="Black" FontSize="18" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8" BorderThickness="1.5" BorderBrush="#475569">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#64748B" Offset="0"/>
                                                    <GradientStop Color="#475569" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
