<Window x:Class="NUSHPOS.Views.Dialogs.MenuItemEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NUSHPOS.Views.Dialogs"
        mc:Ignorable="d"
        Title="MENYU MƏHSULUNUN REDAKTƏSİ" 
        Height="680" Width="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#e8f3fa"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Label Style -->
        <Style x:Key="DlgLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#223b54"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Input Style -->
        <Style x:Key="DlgInput" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#86b7db"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- Small Action Button -->
        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="BorderBrush" Value="#86b7db"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#dce8f5"/>
            <Setter Property="Foreground" Value="#113355"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <!-- Top Section: Form Fields & Big Action Buttons -->
            <RowDefinition Height="260"/>
            <!-- Bottom Section: Tabs -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════════
             TOP SECTION: MAIN PRODUCT FIELDS & BUTTONS
             ════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- Left Form Fields -->
                <ColumnDefinition Width="*"/>
                <!-- Right Action Buttons -->
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT FORM -->
            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <!-- Ürünler aynı özelliklere sahip -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Eyni xüsusiyyətli məhsul" Style="{StaticResource DlgLabel}"/>
                    <ComboBox Grid.Column="1" Height="26"
                              ItemsSource="{Binding TemplateItems}"
                              SelectedItem="{Binding SelectedTemplateItem}"
                              DisplayMemberPath="MenuItemText"
                              VerticalContentAlignment="Center" BorderBrush="#86b7db" Background="White"/>
                </Grid>

                <!-- Məhsulun Tam Adı -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Məhsulun Tam Adı" Style="{StaticResource DlgLabel}"/>
                    <TextBox Grid.Column="1" Style="{StaticResource DlgInput}" Text="{Binding Item.MenuItemText, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold"/>
                </Grid>

                <!-- Menyu Kateqoriyası -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Menyu Kateqoriyası" Style="{StaticResource DlgLabel}"/>
                    <ComboBox Grid.Column="1" Height="26"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="MenuCategoryText"
                              VerticalContentAlignment="Center" BorderBrush="#86b7db" Background="White"/>
                    <Button Grid.Column="2" Content="ƏLAVƏ ET" Style="{StaticResource SmallBtn}"/>
                </Grid>

                <!-- Menyu Qrupu -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Menyu Qrupu" Style="{StaticResource DlgLabel}"/>
                    <ComboBox Grid.Column="1" Height="26"
                              ItemsSource="{Binding Groups}"
                              SelectedItem="{Binding SelectedGroup}"
                              DisplayMemberPath="MenuGroupText"
                              VerticalContentAlignment="Center" BorderBrush="#86b7db" Background="White"/>
                    <Button Grid.Column="2" Content="ƏLAVƏ ET" Style="{StaticResource SmallBtn}"/>
                </Grid>

                <!-- ƏDV Qrupu -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ƏDV Qrupu" Style="{StaticResource DlgLabel}"/>
                    <ComboBox Grid.Column="1" Height="26"
                              ItemsSource="{Binding TaxGroups}"
                              SelectedItem="{Binding SelectedTaxGroup}"
                              DisplayMemberPath="GroupName"
                              VerticalContentAlignment="Center" BorderBrush="#86b7db" Background="White"/>
                    <Button Grid.Column="2" Content="ƏLAVƏ ET" Style="{StaticResource SmallBtn}"/>
                </Grid>

                <!-- Şəkil & Rəng -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Şəkil Faylı" Style="{StaticResource DlgLabel}"/>
                    <TextBox Grid.Column="1" Style="{StaticResource DlgInput}" Text="{Binding Item.PictureName, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Content="..." Style="{StaticResource SmallBtn}" Width="30"/>
                    <Button Grid.Column="3" Content="✕" Style="{StaticResource SmallBtn}" Width="30"/>
                    <!-- Color / Preview Box -->
                    <Border Grid.Column="4" Margin="6,0,0,0" CornerRadius="4" BorderThickness="1" BorderBrush="#86b7db" Height="30">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#e4f1fa" Offset="0.0"/>
                                <GradientStop Color="#bfe0f8" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- RIGHT BIG BUTTONS & CHECKBOXES -->
            <StackPanel Grid.Column="1">
                <!-- TƏSDİQ ET (TAMAM) -->
                <Button Content="TƏSDİQ ET"
                        Command="{Binding SaveCommand}"
                        Background="#3cb84a"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="15"
                        Height="48"
                        BorderThickness="0"
                        Margin="0,0,0,8"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="4" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- İMTİNA (İPTAL) -->
                <Button Content="İMTİNA"
                        Command="{Binding CancelCommand}"
                        Background="#e02d2d"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="15"
                        Height="48"
                        BorderThickness="0"
                        Margin="0,0,0,8"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="4" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- GİZLƏT (GİZLE) -->
                <Button Content="GİZLƏT / DEAKTİV"
                        Command="{Binding HideItemCommand}"
                        Background="#3da7eb"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        Height="46"
                        BorderThickness="0"
                        Margin="0,0,0,10"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="4" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Top level / Combo Checkboxes -->
                <CheckBox Content="Üst səviyyə məhsul" IsChecked="{Binding Item.IsTopMenu}" Margin="0,3" FontSize="12" FontWeight="SemiBold"/>
                <CheckBox Content="Açıq qiymətli məhsul" IsChecked="{Binding Item.MenuItemDiscountable}" Margin="0,3" FontSize="12" FontWeight="SemiBold"/>
                <CheckBox Content="Kombo menyu" IsChecked="{Binding Item.IsComboMenu}" Margin="0,3" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════════
             BOTTOM SECTION: TABS
             ════════════════════════════════════════════════════════════════ -->
        <TabControl Grid.Row="1" Margin="0,10,0,0" Background="White" BorderBrush="#86b7db">
            <!-- TAB 1: MƏHSUL DETALLARI -->
            <TabItem Header="MƏHSUL DETALLARI" FontWeight="Bold" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <!-- Cari Məhsul Qiyməti & Aktiv -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Cari Məhsul Qiyməti" Style="{StaticResource DlgLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource DlgInput}" Text="{Binding Item.DefaultUnitPrice, StringFormat={}{0:N2}, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="2" Text="Aktiv" Style="{StaticResource DlgLabel}" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                            <CheckBox Grid.Column="3" IsChecked="{Binding Item.MenuItemActive}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Göndəriləcək Yazıçı -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Göndəriləcək Yazıçı" Style="{StaticResource DlgLabel}"/>
                            <ComboBox Grid.Column="1" Height="26"
                                      ItemsSource="{Binding Printers}"
                                      SelectedItem="{Binding SelectedPrinter1}"
                                      DisplayMemberPath="PrinterName"
                                      VerticalContentAlignment="Center" BorderBrush="#86b7db" Background="White"/>
                        </Grid>

                        <!-- Mesaj Qrupu -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mesaj Qrupu" Style="{StaticResource DlgLabel}"/>
                            <ComboBox Grid.Column="1" Height="26"
                                      ItemsSource="{Binding ModifierGroups}"
                                      SelectedItem="{Binding SelectedModifierGroup}"
                                      DisplayMemberPath="MenuModifierGroupText"
                                      VerticalContentAlignment="Center" BorderBrush="#86b7db" Background="White"/>
                            <Button Grid.Column="2" Content="ƏLAVƏ ET" Style="{StaticResource SmallBtn}"/>
                            <Button Grid.Column="3" Content="✕" Style="{StaticResource SmallBtn}" Width="28"/>
                        </Grid>

                        <!-- Məcburi Mesaj Qrupu -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Məcburi Mesaj Qrupu" Style="{StaticResource DlgLabel}"/>
                            <ComboBox Grid.Column="1" Height="26"
                                      ItemsSource="{Binding ModifierGroups}"
                                      SelectedItem="{Binding SelectedForcedModifierGroup}"
                                      DisplayMemberPath="MenuModifierGroupText"
                                      VerticalContentAlignment="Center" BorderBrush="#86b7db" Background="White"/>
                            <Button Grid.Column="2" Content="ƏLAVƏ ET" Style="{StaticResource SmallBtn}"/>
                            <Button Grid.Column="3" Content="✕" Style="{StaticResource SmallBtn}" Width="28"/>
                        </Grid>

                        <!-- Kombo Menyu -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Kombo Menyu" Style="{StaticResource DlgLabel}"/>
                            <ComboBox Grid.Column="1" Height="26"
                                      ItemsSource="{Binding ComboItems}"
                                      SelectedItem="{Binding SelectedComboItem}"
                                      DisplayMemberPath="ExtendedMenuName"
                                      VerticalContentAlignment="Center" BorderBrush="#86b7db" Background="White"/>
                            <Button Grid.Column="2" Content="✕" Style="{StaticResource SmallBtn}" Width="28"/>
                        </Grid>

                        <!-- Barkod -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Barkod" Style="{StaticResource DlgLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource DlgInput}" Text="{Binding Item.Barcode, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- Çəkiyə görə & Təhlükəsizlik Səviyyəsi -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Çəkiyə görə sifariş et" Style="{StaticResource DlgLabel}"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding Item.OrderByWeight}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="İcazə Səviyyəsi" Style="{StaticResource DlgLabel}" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="3" Height="26"
                                      ItemsSource="{Binding SecurityLevels}"
                                      SelectedItem="{Binding Item.SecurityLevel}"
                                      VerticalContentAlignment="Center" BorderBrush="#86b7db" Background="White"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: SƏHİFƏ 2 (QİYMƏTLƏR & MODLAR) -->
            <TabItem Header="SƏHİFƏ 2" FontWeight="Bold" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Prices Column -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <!-- Cari Qiymət -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Cari Məhsul Qiyməti" Style="{StaticResource DlgLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource DlgInput}" Text="{Binding Item.DefaultUnitPrice, StringFormat={}{0:N2}, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Masa Modu Qiyməti -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Masa Modu Qiyməti" Style="{StaticResource DlgLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource DlgInput}" Text="{Binding Item.DineInPrice, StringFormat={}{0:N2}, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Bar Çeki Qiyməti -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bar Çeki Qiyməti" Style="{StaticResource DlgLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource DlgInput}" Text="{Binding Item.BarTabPrice, StringFormat={}{0:N2}, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Kassa Satış Qiyməti -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Kassa Satış Qiyməti" Style="{StaticResource DlgLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource DlgInput}" Text="{Binding Item.TakeOutPrice, StringFormat={}{0:N2}, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Paket / Çatdırılma Qiyməti -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Paket Qiyməti" Style="{StaticResource DlgLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource DlgInput}" Text="{Binding Item.DeliveryPrice, StringFormat={}{0:N2}, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Right Settings Column -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <!-- Endirim edilə bilər -->
                            <CheckBox Content="Məhsulda endirim edilə bilər" IsChecked="{Binding Item.MenuItemDiscountable}" Margin="0,4" FontSize="12" FontWeight="SemiBold"/>

                            <!-- Mühasibat Kodu -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mühasibat Kodu" Style="{StaticResource DlgLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource DlgInput}" Text="{Binding Item.AccountingCode, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Etiket Çapı -->
                            <CheckBox Content="Etiket Çapı" IsChecked="{Binding Item.PrintOnLabel}" Margin="0,4" FontSize="12" FontWeight="SemiBold"/>

                            <!-- Mətbəx Göstəriciləri -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mətbəx Göstəricisi" Style="{StaticResource DlgLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource DlgInput}" Text="1"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: SƏHİFƏ 3 (2-Cİ DİL, ÇATDIRILMA, ƏLAVƏ PRİNTERLƏR) -->
            <TabItem Header="SƏHİFƏ 3" FontWeight="Bold" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: 2nd Language -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="2-ci Dil Adı" Style="{StaticResource DlgLabel}" Margin="0,0,0,4"/>
                            <TextBox Height="90" Style="{StaticResource DlgInput}"
                                     Text="{Binding Item.SecLangMenuItemText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap"/>

                            <!-- 2nd Printer -->
                            <Grid Margin="0,10,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Göndəriləcək 2. Yazıçı" Style="{StaticResource DlgLabel}"/>
                                <ComboBox Grid.Column="1" Height="26"
                                          ItemsSource="{Binding Printers}"
                                          SelectedItem="{Binding SelectedPrinter2}"
                                          DisplayMemberPath="PrinterName"
                                          VerticalContentAlignment="Center" BorderBrush="#86b7db" Background="White"/>
                            </Grid>

                            <!-- 3rd Printer -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Göndəriləcək 3. Yazıçı" Style="{StaticResource DlgLabel}"/>
                                <ComboBox Grid.Column="1" Height="26"
                                          ItemsSource="{Binding Printers}"
                                          SelectedItem="{Binding SelectedPrinter3}"
                                          DisplayMemberPath="PrinterName"
                                          VerticalContentAlignment="Center" BorderBrush="#86b7db" Background="White"/>
                            </Grid>
                        </StackPanel>

                        <!-- Right Column: Delivery charges & Barkod 2 -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Paket Haqqı" Style="{StaticResource DlgLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource DlgInput}" Text="{Binding Item.ItemDelCharge, StringFormat={}{0:N2}, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Paket İkramı" Style="{StaticResource DlgLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource DlgInput}" Text="{Binding Item.ItemDelComp, StringFormat={}{0:N2}, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Barkod 2" Style="{StaticResource DlgLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource DlgInput}" Text="{Binding Item.Barcode2, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: MƏTBƏX EKRANLARI (KDS) -->
            <TabItem Header="MƏTBƏX EKRANLARI" FontWeight="Bold" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Text="İSTİFADƏ EDİLƏCƏK MƏTBƏX EKRANLARI (KDS)" FontWeight="Bold" FontSize="13" Foreground="#1f4f7b" Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <CheckBox Content="1 №-li Mətbəx Ekranı" IsChecked="{Binding Item.UseKds1}" Margin="0,6" FontSize="13"/>
                                <CheckBox Content="2 №-li Mətbəx Ekranı" IsChecked="{Binding Item.UseKds2}" Margin="0,6" FontSize="13"/>
                                <CheckBox Content="3 №-li Mətbəx Ekranı" IsChecked="{Binding Item.UseKds3}" Margin="0,6" FontSize="13"/>
                                <CheckBox Content="4 №-li Mətbəx Ekranı" IsChecked="{Binding Item.UseKds4}" Margin="0,6" FontSize="13"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <CheckBox Content="5 №-li Mətbəx Ekranı" IsChecked="{Binding Item.UseKds5}" Margin="0,6" FontSize="13"/>
                                <CheckBox Content="6 №-li Mətbəx Ekranı" IsChecked="{Binding Item.UseKds6}" Margin="0,6" FontSize="13"/>
                                <CheckBox Content="7 №-li Mətbəx Ekranı" IsChecked="{Binding Item.UseKds7}" Margin="0,6" FontSize="13"/>
                                <CheckBox Content="8 №-li Mətbəx Ekranı" IsChecked="{Binding Item.UseKds8}" Margin="0,6" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: ÖLÇÜLƏR / ÇƏKİLƏR (EBATLAR) -->
            <TabItem Header="ÖLÇÜLƏR" FontWeight="Bold" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
