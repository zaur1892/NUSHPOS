<UserControl x:Class="NUSHPOS.Views.MainScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NUSHPOS.Views"
             xmlns:converters="clr-namespace:NUSHPOS.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1024">

    <!-- Main Background (from the user's latest blue image) -->
    <UserControl.Background>
        <SolidColorBrush Color="#5494DB"/>
    </UserControl.Background>
             
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:ImageFileToSourceConverter x:Key="ImageConverter"/>
        
        <Style x:Key="SolidGradientButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="140"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="16">
                            <!-- Subtle highlight for 3D depth -->
                            <Grid>
                                <Border CornerRadius="16" BorderBrush="#40FFFFFF" BorderThickness="1,1,0,0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="8" ShadowDepth="4"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95" CenterX="80" CenterY="70"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Purple Gradient for specific operations -->
        <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9C27B0" Offset="0"/>
            <GradientStop Color="#7B1FA2" Offset="1"/>
        </LinearGradientBrush>
        
        <!-- Dark Blue Dotted/Slate Pattern for Backoffice -->
        <LinearGradientBrush x:Key="BackofficeGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2C3E50" Offset="0"/>
            <GradientStop Color="#1A252F" Offset="1"/>
        </LinearGradientBrush>
        
        <!-- Standard Colors -->
        <LinearGradientBrush x:Key="BlueGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6AA8F5" Offset="0.0"/>
            <GradientStop Color="#4A89E3" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GreenGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#53C85E" Offset="0.0"/>
            <GradientStop Color="#3B9E46" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RedGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E42721" Offset="0.0"/>
            <GradientStop Color="#C11B16" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="YellowGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFF056" Offset="0.0"/>
            <GradientStop Color="#E6C821" Offset="1.0"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/> <!-- Header -->
            <RowDefinition Height="*"/> <!-- Main Content -->
            <RowDefinition Height="40"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- HEADER (Transparent Glass over light bg) -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <Grid Margin="30,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="NushPOS" FontSize="40" FontWeight="Black" Foreground="#005B96" />
                </StackPanel>
                
                <!-- Instagram-style Avatar Profile -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding EmployeeName, FallbackValue='İstifadəçi'}" FontSize="18" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Border Width="45" Height="45" CornerRadius="22.5" BorderBrush="#4CAF50" BorderThickness="2" Background="#F1F5F9">
                        <TextBlock Text="👤" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,3"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="20,20,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/> <!-- Left: Buttons -->
                <ColumnDefinition Width="280"/> <!-- Right: Smart Dashboard Sidebar -->
            </Grid.ColumnDefinitions>

            <!-- LEFT AREA: SERVICES & OPERATIONS -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TOP PANEL: SERVICES (Filtered by Station Settings) -->
                <WrapPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,20">
                    
                    <!-- MASA SATIŞI -->
                    <Button Style="{StaticResource SolidGradientButtonStyle}" 
                            Background="{StaticResource GreenGradient}" 
                            Command="{Binding OpenDineInCommand}"
                            Visibility="{Binding ShowDineInButton, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Height="55" Width="55" Margin="0,0,0,10">
                                <TextBlock Text="🍽️" FontSize="45" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="MASA SATIŞI" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- TAKEAWAY / GÖTÜR-APAR -->
                    <Button Style="{StaticResource SolidGradientButtonStyle}" 
                            Background="{StaticResource BlueGradient}" 
                            Command="{Binding OpenTakeAwayCommand}"
                            Visibility="{Binding ShowTakeOutButton, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Height="55" Width="55" Margin="0,0,0,10">
                                <TextBlock Text="🛍️" FontSize="45" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="TAKEAWAY" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- DRIVE-THRU -->
                    <Button Style="{StaticResource SolidGradientButtonStyle}" 
                            Background="{StaticResource PurpleGradient}" 
                            Command="{Binding OpenDriveThruCommand}"
                            Visibility="{Binding ShowDriveThruButton, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Height="55" Width="55" Margin="0,0,0,10">
                                <TextBlock Text="🚗" FontSize="45" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="DRIVE-THRU" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- PAKET SATIŞI / ÇATDIRILMA -->
                    <Button Style="{StaticResource SolidGradientButtonStyle}" 
                            Background="{StaticResource RedGradient}" 
                            Command="{Binding OpenDeliveryCommand}"
                            Visibility="{Binding ShowDeliveryButton, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Height="55" Width="55" Margin="0,0,0,10">
                                <TextBlock Text="🛵" FontSize="45" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="PAKET SATIŞI" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- Divider Line -->
                <Rectangle Grid.Row="0" VerticalAlignment="Bottom" Height="1" Fill="#201E293B" Margin="50,0,50,0"/>

                <!-- BOTTOM PANEL: OPERATIONS -->
                <WrapPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
                    
                    <!-- ÇEKLƏRİ GÖR -->
                    <Button Style="{StaticResource SolidGradientButtonStyle}" 
                            Background="{StaticResource YellowGradient}" 
                            Foreground="#1E293B" 
                            Command="{Binding OpenRecallCommand}"
                            Visibility="{Binding ShowRecallButton, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Height="55" Width="55" Margin="0,0,0,10">
                                <TextBlock Text="🔍" FontSize="45" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="ÇEKLƏRİ GÖR" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- KURYER VƏZİYYƏTİ -->
                    <Button Style="{StaticResource SolidGradientButtonStyle}" 
                            Background="{StaticResource PurpleGradient}"
                            Command="{Binding OpenDriverStatusCommand}"
                            Visibility="{Binding ShowDriverStatusButton, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Height="55" Width="55" Margin="0,0,0,10">
                                <TextBlock Text="🏃" FontSize="45" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="KURYER VƏZİYYƏTİ" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- KASSA GİRİŞ -->
                    <Button Style="{StaticResource SolidGradientButtonStyle}" Background="{StaticResource GreenGradient}" Command="{Binding OpenCashRegisterInCommand}">
                        <StackPanel>
                            <Grid Height="55" Width="55" Margin="0,0,0,10">
                                <TextBlock Text="🟢" FontSize="45" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="KASSA GİRİŞ" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- KASSA ÇIXIŞ -->
                    <Button Style="{StaticResource SolidGradientButtonStyle}" Background="{StaticResource RedGradient}" Command="{Binding CloseCashRegisterCommand}">
                        <StackPanel>
                            <Grid Height="55" Width="55" Margin="0,0,0,10">
                                <TextBlock Text="🔴" FontSize="45" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="KASSA ÇIXIŞ" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- ƏMƏLİYYATLAR -->
                    <Button Style="{StaticResource SolidGradientButtonStyle}" 
                            Background="{StaticResource BlueGradient}" 
                            Command="{Binding OpenOperationsCommand}"
                            Visibility="{Binding ShowOperationsButton, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Height="55" Width="55" Margin="0,0,0,10">
                                <TextBlock Text="📝" FontSize="45" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="ƏMƏLİYYATLAR" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- BACKOFFICE -->
                    <Button Style="{StaticResource SolidGradientButtonStyle}" 
                            Background="{StaticResource BackofficeGradient}" 
                            Command="{Binding OpenBackOfficeCommand}"
                            Visibility="{Binding ShowBackOfficeButton, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Height="55" Width="55" Margin="0,0,0,10">
                                <TextBlock Text="⚙️" FontSize="45" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="BACKOFFICE" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- ÇIXIŞ -->
                    <Button Style="{StaticResource SolidGradientButtonStyle}" Background="{StaticResource RedGradient}" Command="{Binding LogoutCommand}">
                        <StackPanel>
                            <Grid Height="55" Width="55" Margin="0,0,0,10">
                                <TextBlock Text="🚪" FontSize="45" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="ÇIXIŞ" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>

            <!-- RIGHT AREA: SMART DASHBOARD (Instagram/Modern vibe) -->
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="0"/>
                </Border.Effect>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Metrics Title -->
                        <RowDefinition Height="Auto"/> <!-- Metric Cards -->
                        <RowDefinition Height="Auto"/> <!-- Feed Title -->
                        <RowDefinition Height="*"/>    <!-- Activity Feed -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="GÜNLÜK ÖZƏT" Foreground="#0F172A" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

                    <!-- Metric Cards -->
                    <StackPanel Grid.Row="1">
                        <!-- Sales -->
                        <Border Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#E8F5E9" Width="40" Height="40" CornerRadius="20" Margin="0,0,15,0">
                                    <TextBlock Text="📈" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Gündəlik Sifariş" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DailyOrderCount, StringFormat='\{0\} Ədəd'}" Foreground="#0F172A" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Open Tables -->
                        <Border Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FFF3E0" Width="40" Height="40" CornerRadius="20" Margin="0,0,15,0">
                                    <TextBlock Text="🍽️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Açıq Masalar" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding OpenTableCount, StringFormat='\{0\} Masa'}" Foreground="#0F172A" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Active Couriers -->
                        <Border Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,25">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#E0F7FA" Width="40" Height="40" CornerRadius="20" Margin="0,0,15,0">
                                    <TextBlock Text="🛵" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Kuryer Yolda" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="0 Sifariş" Foreground="#0F172A" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Instagram-style Activity Feed -->
                    <TextBlock Grid.Row="2" Text="SON ƏMƏLİYYATLAR" Foreground="#0F172A" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Feed Item 1 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#4CAF50" VerticalAlignment="Top" Margin="0,5,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Masa 14 hesabı ödənildi" Foreground="#334155" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="2 dəqiqə əvvəl" Foreground="#94A3B8" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Feed Item 2 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#00BCD4" VerticalAlignment="Top" Margin="0,5,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Yeni Takeaway sifarişi" Foreground="#334155" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="5 dəqiqə əvvəl" Foreground="#94A3B8" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Feed Item 3 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#F44336" VerticalAlignment="Top" Margin="0,5,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Kuryer Əli yola düşdü" Foreground="#334155" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="12 dəqiqə əvvəl" Foreground="#94A3B8" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Feed Item 4 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#FF9800" VerticalAlignment="Top" Margin="0,5,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Masa 5-dən çağırış var" Foreground="#334155" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="15 dəqiqə əvvəl" Foreground="#94A3B8" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#1E293B" BorderBrush="#0F172A" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="{Binding CurrentDateTime, FallbackValue='16.08.2026 22:40'}" Foreground="#94A3B8" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                
                <TextBlock Grid.Column="2" Text="{Binding EmployeeName, StringFormat='KASSİR : \{0\}', FallbackValue='KASSİR : NUSHPOS'}" Foreground="#E2E8F0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0"/>
                <TextBlock Grid.Column="3" Text="{Binding StationInfo, StringFormat='TERMİNAL : \{0\}', FallbackValue='TERMİNAL : 1'}" Foreground="#E2E8F0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>
