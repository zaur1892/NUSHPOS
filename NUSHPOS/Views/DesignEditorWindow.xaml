<Window x:Class="NUSHPOS.Views.DesignEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Çap Dizayn Redaktoru" Height="700" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#f8fafc">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="#1e293b" Padding="16,0">
            <Grid>
                <TextBlock Text="ÇAP DİZAYN REDAKTORU (FastReport .NET)" 
                           Foreground="White" 
                           FontSize="15" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- DESIGN INFO & CONTROLS -->
        <Border Grid.Row="1" Background="White" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                        <TextBlock Text="Dizayn Adı:" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding DesignName, UpdateSourceTrigger=PropertyChanged}" Width="220" Height="28" Padding="6,2" VerticalContentAlignment="Center" BorderBrush="#cbd5e1"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                        <TextBlock Text="Sənəd Tipi:" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding DocumentTypeID, UpdateSourceTrigger=PropertyChanged}" Width="60" Height="28" Padding="6,2" VerticalContentAlignment="Center" BorderBrush="#cbd5e1"/>
                    </StackPanel>

                    <CheckBox IsChecked="{Binding IsDefault}" Content="Standart Dizayn Kimi Tətbiq Et" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- ACTION BUTTONS -->
                <WrapPanel Grid.Row="1">
                    <Button Content="👁️ Ön Baxış (Preview)" 
                            Command="{Binding PreviewCommand}" 
                            Style="{StaticResource ActionButton}" 
                            Background="#7c3aed" 
                            Foreground="White" 
                            FontWeight="Bold"
                            Margin="0,0,8,0"/>

                    <Button Content="⚡ FastReport Redaktorunda Aç" 
                            Command="{Binding OpenExternalDesignerCommand}" 
                            Style="{StaticResource ActionButton}" 
                            Background="#0284c7" 
                            Foreground="White" 
                            Margin="0,0,8,0"/>

                    <Button Content="📥 Şablonu İdxal Et (.frx)" 
                            Command="{Binding ImportFrxCommand}" 
                            Style="{StaticResource ActionButton}" 
                            Background="#0d9488" 
                            Foreground="White" 
                            Margin="0,0,8,0"/>

                    <Button Content="📤 Şablonu İxrac Et (.frx)" 
                            Command="{Binding ExportFrxCommand}" 
                            Style="{StaticResource ActionButton}" 
                            Background="#64748b" 
                            Foreground="White" 
                            Margin="0,0,8,0"/>

                    <Button Content="🔄 Standart Şablona Qaytar" 
                            Command="{Binding ResetDefaultTemplateCommand}" 
                            Style="{StaticResource ActionButton}" 
                            Background="#f59e0b" 
                            Foreground="White"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- FRX / XML CONTENT VIEWER & EDITOR -->
        <Grid Grid.Row="2" Margin="16,12,16,6">
            <Border BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="4" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="0,0,0,1" Padding="8,4">
                        <TextBlock Text="Şablon Məzmunu (FastReport XML/FRX Strukturu):" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                    </Border>

                    <TextBox Grid.Row="1" 
                             Text="{Binding DesignData, UpdateSourceTrigger=PropertyChanged}" 
                             FontFamily="Consolas, Courier New" 
                             FontSize="12" 
                             AcceptsReturn="True" 
                             AcceptsTab="True" 
                             HorizontalScrollBarVisibility="Auto" 
                             VerticalScrollBarVisibility="Auto" 
                             BorderThickness="0" 
                             Padding="8"
                             Background="#fafafa"/>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="3" Padding="16,4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#64748b" FontSize="11" FontStyle="Italic"/>
        </Border>

        <!-- BOTTOM BUTTONS -->
        <Border Grid.Row="4" Background="#f1f5f9" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0" Padding="16,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="YADDA SAXLA" 
                        Command="{Binding SaveCommand}" 
                        Style="{StaticResource ActionButton}" 
                        Background="#16a34a" 
                        Foreground="White" 
                        Width="130" 
                        Margin="0,0,8,0"/>

                <Button Content="BAĞLA" 
                        Command="{Binding CancelCommand}" 
                        Style="{StaticResource ActionButton}" 
                        Background="#cbd5e1" 
                        Foreground="#334155" 
                        Width="100"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
